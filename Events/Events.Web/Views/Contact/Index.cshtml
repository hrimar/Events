@model ContactViewModel
@using Events.Web.Models
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Contact_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-envelope-open-text fa-3x text-primary mb-3"></i>
                        <h2 class="fw-bold">@Localizer["Contact_Heading"]</h2>
                        <p class="text-muted">@Localizer["Contact_Subtitle"]</p>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-controller="Contact" asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Honeypot: hidden from sighted users, left empty by real visitors -->
                        <div class="visually-hidden" aria-hidden="true">
                            <label asp-for="Website">Website</label>
                            <input asp-for="Website" tabindex="-1" autocomplete="off" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">@Localizer["Contact_NameLabel"]</label>
                            <input asp-for="Name" class="form-control form-control-lg" aria-required="true" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@Localizer["Contact_EmailLabel"]</label>
                            <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" aria-required="true" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Topic" class="form-label">@Localizer["Contact_TopicLabel"]</label>
                            <select asp-for="Topic" asp-items="Model.TopicOptions" class="form-select form-select-lg">
                                <option value="">@Localizer["Contact_TopicPlaceholder"]</option>
                            </select>
                            <span asp-validation-for="Topic" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Message" class="form-label">@Localizer["Contact_MessageLabel"]</label>
                            <textarea asp-for="Message" class="form-control" rows="5" aria-required="true"></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>@Localizer["Contact_SubmitButton"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
