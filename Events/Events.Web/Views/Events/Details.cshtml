@model Events.Web.Models.EventDetailsViewModel
@using Events.Web.Infrastructure
@using Events.Web.Resources
@using Events.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject ISiteUrlProvider SiteUrlProvider

@{
    var relatedEvents = ViewBag.RelatedEvents as List<Events.Web.Models.EventViewModel> ?? new List<Events.Web.Models.EventViewModel>();
    var isOtherSubCategory = (bool)(ViewBag.IsOtherSubCategory ?? true);
    var currentUrl = SiteUrlProvider.BuildAbsoluteUrl(Context.Request.Path);
    var fullImageUrl = Model.DefaultImage.StartsWith("http") ? Model.DefaultImage : SiteUrlProvider.BuildAbsoluteUrl(Model.DefaultImage);
    var metaDescription = Model.ShortDescription != ""
        ? Model.ShortDescription
        : $"Join us for {Model.Name} on {Model.FormattedDate} in {Model.City}";

    // Per-event title/description (not admin-authored PageSeoMeta, which only covers a
    // fixed small set of static pages - see ISeoMetaService). Mirrors the pattern already
    // used on Venues/Details.cshtml for the same reason.
    ViewData["Title"] = Model.Name;
    ViewData["PageTitle"] = $"{Model.Name} | {Model.Location}, {Model.FormattedDate} | Go Sofia";
    ViewData["MetaDescription"] = metaDescription;
    ViewData["OgType"] = "event";
    ViewData["OgImageUrl"] = fullImageUrl;
    ViewData["OgUrl"] = currentUrl;
    ViewData["CanonicalUrl"] = currentUrl;
}

@* Open Graph / Twitter Card tags are rendered once, in _Layout.cshtml, driven by the
   ViewData set above - no per-view MetaTags override here to avoid duplicate og:/twitter:
   tags. The JSON-LD Event schema below already covers start date/location/etc.,
   so the old non-standard "event:start_date"/"event:location" meta tags were dropped. *@

<div class="container-grid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Localizer["Details_Home"]</a></li>
            <li class="breadcrumb-item"><a asp-controller="Events" asp-action="Index">@Localizer["Details_Events"]</a></li>
            @if(!string.IsNullOrEmpty(Model.CategoryName))
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Events" asp-action="Category" asp-route-category="@Model.CategoryName">
                        @CategoryLocalizationExtensions.LocalizeCategoryName(Model.CategoryName, Localizer)
                    </a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Main Event Details -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <!-- Event Image -->
                <div class="event-detail-image">
                    <img src="@Model.DefaultImage" 
                         alt="@Model.Name" 
                         class="w-100"
                         style="height: 400px; object-fit: contain; background: var(--gs-bg-alt);"
                         onerror="this.src='/images/default_event_image.jpeg'">
                    @* Show 'Free' badge only for free events *@
                    @if (Model.IsFree)
                    {
                        <div class="event-price-overlay event-free">@Localizer["Details_Free"]</div>
                    }
                    @if (Model.IsPastEvent)
                    {
                        <div class="event-badge-past-overlay">@Localizer["Details_PastEvent"]</div>
                    }
                </div>

                <div class="card-body">
                    <!-- Title and Basic Info -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="gs-h1 mb-2">@Model.Name</h1>
                            
                            <div class="mb-3">
                                @if(!string.IsNullOrEmpty(Model.CategoryName))
                                {
                                    <a href="/Events/Category/@Model.CategoryName" class="gs-tag text-decoration-none me-2">
                                        <gs-icon name="layers" class="me-1" />
                                        @CategoryLocalizationExtensions.LocalizeCategoryName(Model.CategoryName, Localizer)
                                    </a>
                                }
                                @if(!string.IsNullOrEmpty(Model.SubCategoryName))
                                {
                                    <a href="@Url.Action("Index", "Events", new { subCategory = Model.SubCategoryName })" 
                                       class="gs-tag text-decoration-none">
                                        <gs-icon name="tags" class="me-1" />
                                        @CategoryLocalizationExtensions.LocalizeSubCategoryName(Model.SubCategoryName, Localizer)
                                    </a>
                                }
                            </div>

                            <!-- Enhanced Tag Display -->
                            @if(Model.Tags.Any())
                            {
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-2">
                                        <gs-icon name="tags" class="me-1" />@Localizer["Details_EventTags"]
                                    </small>
                                    <div class="event-tags-detailed">
                                        @foreach(var tag in Model.Tags)
                                        {
                                            <a href="@Url.Action("ByTag", "Events", new { tagName = tag })" 
                                               class="gs-tag text-decoration-none me-2 mb-2 tag-detail-link">
                                                <gs-icon name="tag" class="me-1" />@CategoryLocalizationExtensions.LocalizeTagName(tag, Localizer)
                                            </a>
                                        }
                                        @if(Model.Tags.Count >= 3)
                                        {
                                            <a href="@Url.Action("Index", "Events", new { tags = string.Join(",", Model.Tags.Take(3)) })" 
                                               class="btn btn-sm btn-outline-info ms-2">
                                                <gs-icon name="search" class="me-1" />@Localizer["Details_FindSimilar"]
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Event Details Grid -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <gs-icon name="calendar" class="gs-text-link me-3" style="width: 20px;" />
                                <div>
                                    <strong>@Localizer[Model.HasKnownTime ? "Details_DateAndTime" : "Details_Date"]</strong><br>
                                    <span class="text-muted">@Model.FormattedDate@(Model.HasKnownTime ? " at " + Model.FormattedTime : "")</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <gs-icon name="map-pin" class="gs-text-link me-3" style="width: 20px;" />
                                <div>
                                    <strong>@Localizer["Details_Location"]</strong><br>
                                    @if (!string.IsNullOrEmpty(Model.VenueSlug))
                                    {
                                        <a asp-area="" asp-controller="Venues" asp-action="Details"
                                           asp-route-slug="@Model.VenueSlug"
                                           class="text-muted text-decoration-none">@Model.Location</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Model.Location</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @* No price display at all *@
                        
                        @*<div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <gs-icon name="clock" class="gs-text-link me-3" style="width: 20px;" />
                                <div>
                                    <strong>@Localizer["Details_Status"]</strong><br>
                                    <span class="badge bg-success">@Model.Status.Localize(Localizer)</span>
                                </div>
                            </div>
                        </div>*@
                    </div>

                    <!-- Description -->
                    @if(!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                        <h4>@Localizer["Details_AboutEvent"]</h4>
                            <div class="text-muted">
                                @Html.Raw(Model.Description.Replace("\n", "<br>"))
                            </div>
                        </div>
                    }

                    <!-- Quick Actions -->
                    <div class="d-flex gap-2 flex-wrap">
                        @if(!string.IsNullOrEmpty(Model.CategoryName))
                        {
                            <a href="@Url.Action("Index", "Events", new { category = Model.CategoryName })" class="btn btn-outline-secondary btn-sm">
                                <gs-icon name="layers" class="me-1" />@Localizer["Details_MoreCategoryEvents"] @CategoryLocalizationExtensions.LocalizeCategoryName(Model.CategoryName, Localizer)
                            </a>
                        }
                        <a href="@Url.Action("Index", "Events", new { search = Model.City })" class="btn btn-outline-secondary btn-sm">
                            <gs-icon name="map-pin" class="me-1" />@Localizer["Details_EventsIn"] @Model.City
                        </a>
                        @if(Model.IsFree)
                        {
                            <a href="@Url.Action("Index", "Events", new { free = true })" class="gs-btn gs-btn-secondary">
                                <gs-icon name="gift" class="me-1" />@Localizer["Details_MoreFreeEvents"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Action Card: "Buy tickets", "Save" and "Share" in one place. From 992px it follows the screen beside the
                 description; on phones it stays below the description (requester's decision, GS-REQ-008). -->
            <div class="card border-0 shadow-sm mt-4 mt-lg-0 mb-4 gs-details-actions">
                <div class="card-body text-center">
                    @if(Model.HasTicketUrl)
                    {
                        <a href="@Model.TicketUrl" target="_blank" class="gs-btn gs-btn-primary w-100 mb-3">
                            <gs-icon name="ticket" class="me-2" />@Localizer["Details_BuyTickets"]
                        </a>
                        <small class="text-muted">@Localizer["Details_TicketRedirect"]</small>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <gs-icon name="info" />
                            @Localizer["Details_TicketNotAvailable"]
                        </div>
                    }

                    <div class="gs-details-share mt-3">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <button class="gs-btn gs-btn-secondary" onclick="toggleFavorite(@Model.Id)"
                                    data-label="@Localizer["Details_Save"]"
                                    data-title-add="@Localizer["Favorites_AddTitle"]"
                                    data-title-remove="@Localizer["Favorites_RemoveTitle"]"
                                    data-error-message="@Localizer["Favorites_Error"]">
                                <gs-icon name="heart" class="gs-icon-filled" /> @Localizer["Details_Save"]
                            </button>
                        }
                        else
                        {
                            <a href="/Identity/Account/Login?returnUrl=@Url.Action("Details", "Events", 
                                new { id = Model.Id })" class="gs-btn gs-btn-secondary">
                                <gs-icon name="heart" class="gs-icon-filled" /> @Localizer["Details_LoginToSave"]
                            </a>
                        }
                        <div class="dropdown">
                            <button class="gs-btn gs-btn-secondary w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <gs-icon name="share-2" /> @Localizer["Details_Share"]
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" onclick="shareEvent('facebook')">
                                    <gs-icon name="facebook" class="gs-text-link me-2" />Facebook
                                </a></li>
                                <li><a class="dropdown-item" href="#" onclick="shareEvent('twitter')">
                                    <gs-icon name="twitter" class="gs-text-link me-2" />Twitter
                                </a></li>
                                <li><a class="dropdown-item" href="#" onclick="shareEvent('whatsapp')">
                                    <gs-icon name="message-circle" class="text-success me-2" />WhatsApp
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#" onclick="copyLink()">
                                    <gs-icon name="link" class="me-2" />@Localizer["Details_CopyLink"]
                                </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- You might like: 4 standard cards in a row, without another performance of this event on the same day
         (GS-REQ-008, 8.1, RelatedEventsSelector) -->
    @if(relatedEvents.Any())
    {
        <section class="mt-5" aria-labelledby="gs-related-title">
            <div class="gs-section-head">
                <h2 id="gs-related-title" class="gs-h2 gs-section-title">@Localizer["Details_YouMightLike"]</h2>
                @if(!string.IsNullOrEmpty(Model.CategoryName))
                {
                    <div class="gs-section-actions">
                        @if (!isOtherSubCategory && !string.IsNullOrEmpty(Model.SubCategoryName))
                        {
                            <a href="@Url.Action("Index", "Events", new { category = Model.CategoryName, subCategory = Model.SubCategoryName })"
                               class="gs-section-link">
                                @Localizer["Details_ViewAllCategoryEvents"] @CategoryLocalizationExtensions.LocalizeSubCategoryName(Model.SubCategoryName, Localizer)
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Events", new { category = Model.CategoryName })" class="gs-section-link">
                                @Localizer["Details_ViewAllCategoryEvents"] @CategoryLocalizationExtensions.LocalizeCategoryName(Model.CategoryName, Localizer)
                            </a>
                        }
                    </div>
                }
            </div>
            <ul class="gs-event-grid">
                @foreach(var relatedEvent in relatedEvents)
                {
                    <li><partial name="_EventCard" model="EventCardViewModel.FromEvent(relatedEvent)" /></li>
                }
            </ul>
        </section>
    }
</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(Model.JsonLd))
    {
        <script type="application/ld+json">@Html.Raw(Model.JsonLd)</script>
    }

    <script src="~/js/favorites.js"></script>
    <script>
        const shareTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name ?? string.Empty));

        function toggleFavorite(eventId) {
            const button = event.target.closest('button');
            Favorites.toggleFavorite(eventId, button);
        }

        function shareEvent(platform) {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent(shareTitle);
            
            let shareUrl = '';
            switch(platform) {
                case 'facebook':
                    shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
                    break;
                case 'twitter':
                    shareUrl = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
                    break;
                case 'whatsapp':
                    shareUrl = `https://wa.me/?text=${title} ${url}`;
                    break;
            }
            
            if(shareUrl) {
                window.open(shareUrl, '_blank', 'width=600,height=400');
            }
        }

        function copyLink() {
            navigator.clipboard.writeText(window.location.href)
                .then(() => {
                    Favorites.showMessage('@Localizer["Details_LinkCopied"]', 'success');
                })
                .catch(() => {
                    Favorites.showMessage('@Localizer["Details_LinkCopyFailed"]', 'error');
                });
        }
    </script>
    
    <!-- Custom CSS for enhanced details page -->
    <style>
        .tag-detail-link {
            font-size: 0.9rem;
            padding: 0.4rem 0.8rem;
            transition: all 0.2s;
        }
        
        .tag-detail-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        
        .event-tags-detailed .badge {
            border: 1px solid rgba(255,255,255,0.2);
        }
        
        .border-start {
            border-left: 3px solid var(--bs-info) !important;
        }
        
        .toast {
            z-index: 9999;
        }

        /* "Save" and "Share" side by side under "Buy tickets" */
        .gs-details-share {
            display: flex;
            gap: 8px;
        }

        .gs-details-share > * {
            flex: 1 1 0;
            min-width: 0;
        }

        /* The ticket block follows the screen beside the description; the site header is not sticky, so 24px from
           the top. On phones the column is below the description and the block stays in place. */
        @@media (min-width: 992px) {
            .gs-details-actions {
                position: sticky;
                top: 24px;
            }
        }
    </style>
}