@model Events.Web.Models.EventViewModel
@using Events.Web.Resources
@using Events.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@* Event card for the "All events" grid and the past search matches block.
   Replaced by the standard card component in GS-REQ-006. *@
<div class="col-lg-4 col-md-6 mb-4">
    <div class="card event-card h-100">
        <a href="@Url.Action("Details", "Events", new { id = Model.Id })" class="text-decoration-none">
            <div class="event-image-container">
                <img src="@Model.DefaultImage" 
                     alt="@Model.Name" 
                     class="event-image-full"
                     onerror="this.src='/images/default_event_image.jpeg'">
                @* Show 'Free' badge only for free events *@
                @if (Model.IsFree)
                {
                <div class="event-price event-free">@Localizer["Events_Free"]</div>
                }
                @if (Model.IsPastEvent)
                {
                <div class="event-badge-past">@Localizer["Events_PastEvent"]</div>
                }
            </div>
        </a>
        
        <div class="card-body d-flex flex-column">
            <h5 class="event-title">
                <a href="@Url.Action("Details", "Events", new { id = Model.Id })" class="text-decoration-none text-body">
                    @Model.Name
                </a>
            </h5>
            <div class="event-date mb-2">
                <i class="fas fa-calendar me-1"></i>
                @Model.FormattedDate@(Model.HasKnownTime ? " " + Model.FormattedTime : "")
            </div>
            <div class="event-venue mb-2">
                <i class="fas fa-map-marker-alt me-1"></i>
                @if (!string.IsNullOrEmpty(Model.VenueSlug))
                {
                    <a asp-area="" asp-controller="Venues" asp-action="Details"
                       asp-route-slug="@Model.VenueSlug"
                       class="text-decoration-none text-muted">@Model.Location</a>
                }
                else
                {
                    @Model.Location
                }
            </div>
            
            @if(!string.IsNullOrEmpty(Model.CategoryName))
            {
                <div class="mb-2">
                    <a href="@Url.Action("Category", "Events", new { category = Model.CategoryName })" class="badge bg-secondary text-decoration-none">
                        @CategoryLocalizationExtensions.LocalizeCategoryName(Model.CategoryName, Localizer)
                    </a>
                    @if(!string.IsNullOrEmpty(Model.SubCategoryName))
                    {
                        <a href="@Url.Action("Index", "Events", new { category = Model.CategoryName, subCategory = Model.SubCategoryName })"
                           class="badge bg-dark text-decoration-none ms-1">
                            @CategoryLocalizationExtensions.LocalizeSubCategoryName(Model.SubCategoryName, Localizer)
                        </a>
                    }
                </div>
            }
            
            <!-- Enhanced Tag Display -->
            @if(Model.Tags.Any())
            {
                <div class="event-tags mb-2">
                    @foreach(var tag in Model.Tags.Take(4))
                    {
                        <a href="@Url.Action("ByTag", "Events", new { tagName = tag })" 
                           class="badge bg-info text-white text-decoration-none me-1 mb-1 tag-link">
                            <i class="fas fa-tag me-1"></i>@CategoryLocalizationExtensions.LocalizeTagName(tag, Localizer)
                        </a>
                    }
                    @if(Model.Tags.Count > 4)
                    {
                        <span class="badge bg-light text-dark">+@(Model.Tags.Count - 4) @Localizer["Events_More"]</span>
                    }
                </div>
            }
            
            @if(!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p class="text-muted small flex-grow-1">@Model.ShortDescription</p>
            }
        </div>
        
        <div class="card-footer bg-transparent">
            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Details", "Events", new { id = Model.Id })" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-info-circle me-1"></i>@Localizer["Events_Details"]
                </a>
                @if(Model.HasTicketUrl)
                {
                    <a href="@Model.TicketUrl" target="_blank" class="btn btn-primary btn-sm">
                        <i class="fas fa-ticket-alt me-1"></i>@Localizer["Events_BuyTickets"]
                    </a>
                }
            </div>
        </div>
    </div>
</div>
