@model Events.Web.Models.EventsPageViewModel
@using System.Globalization
@using Events.Web.Resources
@using Events.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Model.PageTitle;
    var isEnglish = CultureHelper.IsEnglish();
    var shortDateFormat = CultureHelper.ShortDateFormat(isEnglish);
    if (!string.IsNullOrWhiteSpace(Model.PageMetaDescription))
    {
        ViewData["MetaDescription"] = Model.PageMetaDescription;
    }
}

<!-- Enhanced Filters Section -->
<section class="filters-section bg-light py-4">
    <div class="container-grid">
        <form method="get" class="row g-3" id="search-form">
            <!-- Category -->
            <div class="col-md-2">
                <label for="category" class="form-label">@Localizer["Events_Category"]</label>
                <select class="form-select" id="category" name="category">
                    <option value="">@Localizer["Events_AllCategories"]</option>
                    @* A category list from a homepage quick filter stays selected, so submitting the form keeps it. *@
                    @if (Model.SelectedCategories.Count > 1)
                    {
                        <option value="@Model.CurrentCategory" selected>
                            @string.Join(", ", Model.SelectedCategories.Select(c =>
                                Model.LocalizedCategories.FirstOrDefault(l => string.Equals(l.Value, c, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? c))
                        </option>
                    }
                    @foreach(var cat in Model.LocalizedCategories)
                    {
                        <option value="@cat.Value" selected="@(Model.CurrentCategory == cat.Value)">
                            @cat.DisplayName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label for="subCategory" class="form-label">@Localizer["Events_Subcategory"]</label>
                <select class="form-select" id="subCategory" name="subCategory">
                    @if(Model.AvailableSubCategories.Any())
                    {
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedSubCategory))">
                            @Localizer["Events_AllSubcategories"]
                        </option>
                        @foreach(var option in Model.AvailableSubCategories)
                        {
                            <option value="@option.Value" selected="@(option.Selected)">
                                @option.Text
                            </option>
                        }
                    }
                    else
                    {
                        <option value="" selected>@Localizer["Events_SelectCategoryFirst"]</option>
                    }
                </select>
            </div>

            <!-- Price Filter -->
            <div class="col-md-2">
                <label for="free" class="form-label">@Localizer["Events_Price"]</label>
                <select class="form-select" id="free" name="free">
                    <option value="">@Localizer["Events_AllEvents"]</option>
                    <option value="true" selected="@(Model.IsFreeFilter == true)">@Localizer["Events_FreeOnly"]</option>
                    <option value="false" selected="@(Model.IsFreeFilter == false)">@Localizer["Events_PaidOnly"]</option>
                </select>
            </div>

            <!-- Date From -->
            <div class="col-md-2">
                <label for="fromDate" class="form-label">@Localizer["Events_FromDate"]</label>
                <input type="text" class="form-control js-date-input" id="fromDate" name="fromDate"
                       value="@Model.FromDate?.ToString("yyyy-MM-dd")" autocomplete="off">
            </div>

            <!-- Date To -->
            <div class="col-md-2">
                <label for="toDate" class="form-label">@Localizer["Events_ToDate"]</label>
                <input type="text" class="form-control js-date-input" id="toDate" name="toDate"
                       value="@Model.ToDate?.ToString("yyyy-MM-dd")" autocomplete="off">
            </div>

            <!-- Actions -->
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="gs-btn gs-btn-primary w-100">
                    <gs-icon name="search" />
                </button>
            </div>

            <!-- Hidden field for selected tags -->
            <input type="hidden" id="tags" name="tags" value="@string.Join(",", Model.SelectedTags)">

            @* Keeps the homepage period while other filters change; explicit from/to dates still take priority. *@
            @if (Model.Period.HasValue)
            {
                <input type="hidden" name="period" value="@Model.PeriodQueryValue">
            }
        </form>
        
        <!-- Tag Cloud Section -->
        @if(Model.PopularTags.Any())
        {
            <div class="mt-4">
                <div class="d-flex align-items-center mb-3">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#tagCloud"
                            aria-expanded="@(Model.SelectedTags.Any() ? "true" : "false")" aria-controls="tagCloud">
                        <gs-icon name="tags" /> @Localizer["Events_BrowseTags"]
                    </button>
                </div>
                
                @* The "Popular tags" heading lives inside the collapsible panel, so it is only shown together with the tags. *@
                <div class="collapse @(Model.SelectedTags.Any() ? "show" : "")" id="tagCloud">
                    <div class="bg-surface p-3 rounded border">
                        <h6 class="mb-3">@Localizer["Events_PopularTags"]</h6>
                        <!-- Selected Tags -->
                        @if(Model.SelectedTags.Any())
                        {
                            <div class="mb-3">
                                <small class="text-muted">@Localizer["Events_SelectedTags"]</small>
                                <div class="mt-1">
                                    @foreach(var selectedTag in Model.SelectedTags)
                                    {
                                        <span class="gs-tag me-1 mb-1" style="font-size: 0.9rem;">
                                            <gs-icon name="tag" class="me-1" />@CategoryLocalizationExtensions.LocalizeTagName(selectedTag, Localizer)
                                            <button type="button" class="btn-close ms-1" style="font-size: 0.6rem;" onclick="removeTag('@selectedTag')"></button>
                                        </span>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="clearAllTags()">
                                        <gs-icon name="x" /> @Localizer["Events_ClearAll"]
                                    </button>
                                </div>
                            </div>
                            <hr>
                        }

                        <!-- Popular Tags by Category -->
                        @if(Model.PopularTagsByCategory.Any())
                        {
                            @foreach(var categoryGroup in Model.PopularTagsByCategory.Take(4))
                            {
                                <div class="mb-3">
                                    <small class="text-muted d-flex align-items-center">
                                        <gs-icon name="@(Model.LocalizedCategories.FirstOrDefault(c => c.Value == categoryGroup.Key.ToString())?.IconName ?? "calendar")" class="me-1" />
                                        @Model.LocalizedCategories.FirstOrDefault(c => c.Value == categoryGroup.Key.ToString())?.DisplayName @Localizer["Events_Tags"]
                                    </small>
                                    <div class="mt-1">
                                        @foreach(var tag in categoryGroup.Value.Take(8))
                                        {
                                            <button type="button" class="btn btn-sm @tag.BadgeClass me-1 mb-1 tag-button @(Model.SelectedTags.Contains(tag.Name) ? "active" : "")" 
                                                    onclick="toggleTag('@tag.Name')">
                                                @CategoryLocalizationExtensions.LocalizeTagName(tag.Name, Localizer) <span class="badge bg-light text-dark ms-1">@tag.EventCount</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- All Popular Tags (fallback) -->
                            <div class="tag-cloud">
                                @foreach(var tag in Model.TopTags)
                                {
                                    <button type="button" class="btn btn-sm @tag.BadgeClass me-1 mb-1 tag-button @tag.Size @(Model.SelectedTags.Contains(tag.Name) ? "active" : "")" 
                                            onclick="toggleTag('@tag.Name')">
                                        @CategoryLocalizationExtensions.LocalizeTagName(tag.Name, Localizer) <span class="badge bg-light text-dark ms-1">@tag.EventCount</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        
        <!-- Active Filters Display -->
        @if(Model.HasActiveFilters)
        {
            <div class="mt-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted">@Localizer["Events_ActiveFilters"]</span>
                    @foreach(var selectedCategory in Model.SelectedCategories)
                    {
                        var activeCatDisplay = Model.LocalizedCategories.FirstOrDefault(c => string.Equals(c.Value, selectedCategory, StringComparison.OrdinalIgnoreCase));
                        <span class="gs-tag">
                            <gs-icon name="layers" class="me-1" />@Localizer["Events_FilterCategory"] @(activeCatDisplay?.DisplayName ?? selectedCategory)
                        </span>
                    }
                    @if(Model.Period.HasValue)
                    {
                        <span class="gs-tag">
                            <gs-icon name="calendar" class="me-1" />@Localizer["Events_FilterPeriod"] @Model.Period.Value.Localize(Localizer)
                        </span>
                    }
                    @if(!string.IsNullOrEmpty(Model.SelectedSubCategory))
                    {
                        <span class="gs-tag">
                            <gs-icon name="layers" class="me-1" />@Localizer["Events_FilterSubCategory"] @CategoryLocalizationExtensions.LocalizeSubCategoryName(Model.SelectedSubCategory, Localizer)
                        </span>
                    }
                    @if(Model.IsFreeFilter == true)
                    {
                        <span class="gs-tag">
                            <gs-icon name="gift" class="me-1" />@Localizer["Events_FilterFreeEvents"]
                        </span>
                    }
                    @if(Model.IsFreeFilter == false)
                    {
                        <span class="gs-tag">
                            <gs-icon name="banknote" class="me-1" />@Localizer["Events_FilterPaidEvents"]
                        </span>
                    }
                    @if(!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <span class="gs-tag">
                            <gs-icon name="search" class="me-1" />@Localizer["Events_FilterSearch"] "@Model.SearchTerm"
                        </span>
                    }
                    @if(Model.SelectedTags.Any())
                    {
                        <span class="gs-tag">
                            <gs-icon name="tags" class="me-1" />@Localizer["Events_Tags"]: @Model.SelectedTags.Count
                        </span>
                    }
                    <a href="/Events" class="btn btn-outline-secondary btn-sm">
                        <gs-icon name="x" /> @Localizer["Events_ClearAll"]
                    </a>
                </div>
            </div>
        }
    </div>
</section>

<!-- Sorting and View Options -->
<div class="sorting-bar py-3">
    <div class="container-grid">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted">@Localizer["Events_SortBy"]</span>
                    <div class="btn-group" role="group">
                        @foreach(var sortOption in Model.LocalizedSortOptions)
                        {
                            var isCurrentSort = Model.SortBy == sortOption.Value;
                            var newSortOrder = isCurrentSort && Model.SortOrder == "asc" ? "desc" : "asc";
                            
                            <a href="@Url.Action("Index", "Events", new {
                                    category = Model.CurrentCategory,
                                    free = Model.IsFreeFilter,
                                    search = Model.SearchTerm,
                                    tags = string.Join(",", Model.SelectedTags),
                                    fromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                                    toDate = Model.ToDate?.ToString("yyyy-MM-dd"),
                                    period = Model.PeriodQueryValue,
                                    sortBy = sortOption.Value,
                                    sortOrder = newSortOrder,
                                    page = 1
                            })" 
                               class="gs-btn @(isCurrentSort ? "gs-btn-primary" : "gs-btn-secondary")" aria-current="@(isCurrentSort ? "true" : null)">
                                <gs-icon name="@sortOption.IconName" class="me-1" />@sortOption.DisplayName
                                @if(isCurrentSort)
                                {
                                    <gs-icon name="@(Model.SortOrder == "asc" ? "chevron-up" : "chevron-down")" class="ms-1" />
                                }
                            </a>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex align-items-center justify-content-end gap-2">
                    <span class="text-muted">@Localizer["Events_View"]</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary active" id="grid-view">
                            <gs-icon name="layout-grid" />
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="list-view">
                            <gs-icon name="list" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Results Section -->
<section class="py-4">
    <div class="container-grid">
        <!-- Results Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="gs-h1">@Model.Heading</h1>
                @if(Model.HasActiveFilters)
                {
                    <p class="text-muted mb-0">
                        @Localizer["Events_FilteredResults"]
                        @foreach(var selectedCategory in Model.SelectedCategories)
                        {
                            var resultCatDisplay = Model.LocalizedCategories.FirstOrDefault(c => string.Equals(c.Value, selectedCategory, StringComparison.OrdinalIgnoreCase));
                            <span class="gs-tag">@(resultCatDisplay?.DisplayName ?? selectedCategory)</span>
                        }
                        @if(Model.Period.HasValue)
                        {
                            <span class="gs-tag">@Model.Period.Value.Localize(Localizer)</span>
                        }
                        @if(!string.IsNullOrEmpty(Model.SelectedSubCategory))
                        {
                            <span class="gs-tag">@CategoryLocalizationExtensions.LocalizeSubCategoryName(Model.SelectedSubCategory, Localizer)</span>
                        }
                        @if(Model.IsFreeFilter == true)
                        {
                            <span class="gs-tag">@Localizer["Events_FilterFreeEvents"]</span>
                        }
                        @if(Model.IsFreeFilter == false)
                        {
                            <span class="gs-tag">@Localizer["Events_FilterPaidEvents"]</span>
                        }
                        @if(Model.HasCustomFromDate && Model.FromDate.HasValue)
                        {
                            <span class="gs-tag">@Localizer["Events_FilterFromDate"] @Model.FromDate.Value.ToString(shortDateFormat, CultureInfo.InvariantCulture)</span>
                        }
                        @* With a period the dates are its own, already shown by the period tag *@
                        @if(Model.ToDate.HasValue && !Model.Period.HasValue)
                        {
                            <span class="gs-tag">@Localizer["Events_FilterToDate"] @Model.ToDate.Value.ToString(shortDateFormat, CultureInfo.InvariantCulture)</span>
                        }
                        @if(Model.SelectedTags.Any())
                        {
                            <span class="gs-tag">@Localizer["Events_Tags"]: @Model.SelectedTags.Count</span>
                        }
                    </p>
                }
            </div>
            @if (Model.Events.TotalCount > 0)
            {
                <small class="text-muted">
                    @Localizer["Events_ShowingRange",
                        (Model.Events.CurrentPage - 1) * Model.Events.PageSize + 1,
                        Math.Min(Model.Events.CurrentPage * Model.Events.PageSize, Model.Events.TotalCount),
                        Model.Events.TotalCount]
                </small>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(Model.PeriodFallbackMessage))
        {
            <div class="alert alert-info" role="status">@Model.PeriodFallbackMessage</div>
        }

        <!-- Events Grid -->
        <div class="row">
            @if(Model.Events.Items.Any())
            {
                @foreach(var eventItem in Model.Events.Items)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <partial name="_EventCard" model="EventCardViewModel.FromEvent(eventItem)" />
                    </div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <div class="col-12 py-4">
                    <h4 class="text-muted">@Localizer["Events_NoUpcomingForSearch", Model.SearchTerm]</h4>
                </div>
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <gs-icon name="calendar-x" class="text-muted" style="font-size: 4rem;" />
                    <h4 class="mt-3 text-muted">@Localizer["Events_NoEventsFound"]</h4>
                    <p class="text-muted">@Localizer["Events_NoEventsHint"]</p>
                    <a href="/Events" class="gs-btn gs-btn-primary">@Localizer["Events_ViewAllEvents"]</a>
                </div>
            }
        </div>

        @* Past search matches - shown below the last page of upcoming results. *@
        @if (Model.PastSearchResults.Any())
        {
            <h3 class="mt-4 mb-3">@Localizer["Events_PastEventsHeading"]</h3>
            <div class="row">
                @foreach (var pastItem in Model.PastSearchResults)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <partial name="_EventCard" model="EventCardViewModel.FromEvent(pastItem)" />
                    </div>
                }
            </div>
        }
        
        <!-- Pagination -->
        @if(Model.Events.TotalPages > 1)
        {
            <nav aria-label="Events pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    @if(Model.Events.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Events.CurrentPage - 1)&@Model.FiltersQueryString">
                                <gs-icon name="chevron-left" /> @Localizer["Events_Previous"]
                            </a>
                        </li>
                    }
                    
                    @for(var i = Math.Max(1, Model.Events.CurrentPage - 2); i <= Math.Min(Model.Events.TotalPages, Model.Events.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.Events.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&@Model.FiltersQueryString">@i</a>
                        </li>
                    }
                    
                    @if(Model.Events.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Events.CurrentPage + 1)&@Model.FiltersQueryString">
                                @Localizer["Events_Next"] <gs-icon name="chevron-right" />
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/lib/flatpickr/dist/flatpickr.min.css" />
}

@section Scripts {
    <script src="~/lib/flatpickr/dist/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/dist/l10n/bg.js"></script>
    <script>
        // Date filters: the visible field shows dd.mm.yyyy (BG) or dd/mm/yyyy (EN), weeks start on Monday,
        // while the submitted value stays ISO yyyy-MM-dd (the server-side contract is unchanged).
        (function () {
            const isEnglish = @Json.Serialize(isEnglish);
            const baseLocale = isEnglish ? flatpickr.l10ns.default : flatpickr.l10ns.bg;

            flatpickr('.js-date-input', {
                locale: Object.assign({}, baseLocale, { firstDayOfWeek: 1 }),
                dateFormat: 'Y-m-d',
                altInput: true,
                altFormat: isEnglish ? 'd/m/Y' : 'd.m.Y',
                allowInput: true,
                disableMobile: true
            });
        })();
    </script>
    <!-- Enhanced search and tag functionality -->
    <script>
        // Selected tags array
        let selectedTags = [@Html.Raw(string.Join(",", Model.SelectedTags.Select(t => "\"" + t + "\"")))]
        
        // Tag management functions
        function toggleTag(tagName) {
            if (selectedTags.includes(tagName)) {
                removeTag(tagName);
            } else {
                addTag(tagName);
            }
            $('#search-form').submit();
        }
        
        function addTag(tagName) {
            if (!selectedTags.includes(tagName)) {
                selectedTags.push(tagName);
                updateTagsInput();
                updateTagButtons();
            }
        }
        
        function removeTag(tagName) {
            selectedTags = selectedTags.filter(tag => tag !== tagName);
            updateTagsInput();
            updateTagButtons();
            $('#search-form').submit();
        }
        
        function clearAllTags() {
            selectedTags = [];
            updateTagsInput();
            updateTagButtons();
            $('#search-form').submit();
        }
        
        function updateTagsInput() {
            document.getElementById('tags').value = selectedTags.join(',');
        }
        
        function updateTagButtons() {
            document.querySelectorAll('.tag-button').forEach(button => {
                const tagName = button.textContent.split(' ')[0]; // Get tag name before count
                if (selectedTags.includes(tagName)) {
                    button.classList.add('active');
                } else {
                    button.classList.remove('active');
                }
            });
        }
        
        // Initialize search functionality when document is ready
        $(document).ready(function() {
            // AJAX handler for category change - populate subcategories dynamically
            $('#category').change(function() {
                const selectedCategory = $(this).val();
                const $subCategorySelect = $('#subCategory');
                
                if (!selectedCategory) {
                    $subCategorySelect.html('<option value="" selected>@Localizer["Events_SelectCategoryFirst"]</option>');
                    return;
                }
                
                $.ajax({
                    url: '/api/categories/subcategories',
                    data: { category: selectedCategory },
                    success: function(data) {
                        let html = '<option value="" selected>@Localizer["Events_AllSubcategories"]</option>';
                        
                        if (data && data.length > 0) {
                            $.each(data, function(index, item) {
                                html += '<option value="' + item.id + '">' + item.name + '</option>';
                            });
                        } else {
                            html = '<option value="" selected>@Localizer["Events_SelectCategoryFirst"]</option>';
                        }
                        
                        $subCategorySelect.html(html);
                    },
                    error: function(err) {
                        console.error('Error loading subcategories:', err);
                        $subCategorySelect.html('<option value="" selected>@Localizer["Events_SelectCategoryFirst"]</option>');
                    }
                });
                
                // Auto-submit form when category changes
                $('#search-form').submit();
            });
            
            // Auto-submit form when major filters change (instant feedback for better UX)
            $('#subCategory, #free, #fromDate, #toDate').change(function() {
                $('#search-form').submit();
            });
        });
    </script>
    
    <!-- Custom CSS for tag functionality -->
    <style>
        .tag-button.active {
            opacity: 0.8;
            box-shadow: 0 0 0 2px rgba(var(--bs-primary-rgb), 0.25);
        }
        
        .tag-link:hover {
            transform: translateY(-1px);
            transition: transform 0.2s;
        }
        
        .event-tags .badge {
            transition: all 0.2s;
        }
        
        .event-tags .badge:hover {
            transform: scale(1.05);
        }
        
        .autocomplete-item {
            padding: 8px;
        }
        
        .tag-cloud .btn {
            margin-right: 4px;
            margin-bottom: 4px;
        }
    </style>
}