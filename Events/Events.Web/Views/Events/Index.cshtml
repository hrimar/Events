@model Events.Web.Models.EventsPageViewModel
@using Events.Web.Resources
@using Events.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Model.PageTitle;
    if (!string.IsNullOrWhiteSpace(Model.PageMetaDescription))
    {
        ViewData["MetaDescription"] = Model.PageMetaDescription;
    }

    // The current filters with another sort; back to the first page.
    Dictionary<string, string> SortRoute(string sortBy, string sortOrder)
    {
        var route = Model.Filters.FilterRoute();
        route["sortBy"] = sortBy;
        route["sortOrder"] = sortOrder;
        return route;
    }
}

@* Head of the paged list: H1 and the number of events, the "When" and "Filters" rows of the period view, the
   tag cloud and the sort chips (GS-REQ-008, 8.1, 8.2.4, 8.2.5). They replace the old filter form. *@
<section class="gs-period-head container-grid">
    <div class="gs-period-titles">
        <h1 class="gs-h1">@Model.Heading</h1>
        @if (Model.Events.TotalCount > 0)
        {
            <p class="gs-period-summary">
                @Localizer["Events_ShowingRange",
                    (Model.Events.CurrentPage - 1) * Model.Events.PageSize + 1,
                    Math.Min(Model.Events.CurrentPage * Model.Events.PageSize, Model.Events.TotalCount),
                    Model.Events.TotalCount]
            </p>
        }
    </div>

    <partial name="_EventFilterRows" model="Model.Filters" />

    @if (!string.IsNullOrEmpty(Model.PeriodFallbackMessage))
    {
        <p class="alert alert-info gs-period-notice" role="status">@Model.PeriodFallbackMessage</p>
    }

    <!-- Tag Cloud Section: every tag is a link that adds or removes it, keeping the other filters -->
    @if(Model.PopularTags.Any())
    {
        <div>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#tagCloud"
                    aria-expanded="@(Model.SelectedTags.Any() ? "true" : "false")" aria-controls="tagCloud">
                <gs-icon name="tags" /> @Localizer["Events_BrowseTags"]
            </button>

            @* The "Popular tags" heading lives inside the collapsible panel, so it is only shown together with the tags. *@
            <div class="collapse @(Model.SelectedTags.Any() ? "show" : "")" id="tagCloud">
                <div class="bg-surface p-3 rounded border mt-3">
                    <h6 class="mb-3">@Localizer["Events_PopularTags"]</h6>
                    <!-- Selected Tags -->
                    @if(Model.SelectedTags.Any())
                    {
                        <div class="mb-3">
                            <small class="text-muted">@Localizer["Events_SelectedTags"]</small>
                            <div class="mt-1">
                                @foreach(var selectedTag in Model.SelectedTags)
                                {
                                    var selectedTagName = CategoryLocalizationExtensions.LocalizeTagName(selectedTag, Localizer);
                                    <a class="gs-tag me-1 mb-1 text-decoration-none" style="font-size: 0.9rem;"
                                       asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.Filters.RouteWithTagToggled(selectedTag)"
                                       aria-label="@Localizer["Events_RemoveFilter", selectedTagName]">
                                        <gs-icon name="tag" class="me-1" />@selectedTagName <gs-icon name="x" class="ms-1" />
                                    </a>
                                }
                                <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Events" asp-action="Index"
                                   asp-all-route-data="@Model.Filters.RouteWith("tags", null)">
                                    <gs-icon name="x" /> @Localizer["Events_ClearAll"]
                                </a>
                            </div>
                        </div>
                        <hr>
                    }

                    <!-- Popular Tags by Category -->
                    @if(Model.PopularTagsByCategory.Any())
                    {
                        @foreach(var categoryGroup in Model.PopularTagsByCategory.Take(4))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-flex align-items-center">
                                    <gs-icon name="@(Model.LocalizedCategories.FirstOrDefault(c => c.Value == categoryGroup.Key.ToString())?.IconName ?? "calendar")" class="me-1" />
                                    @Model.LocalizedCategories.FirstOrDefault(c => c.Value == categoryGroup.Key.ToString())?.DisplayName @Localizer["Events_Tags"]
                                </small>
                                <div class="mt-1">
                                    @foreach(var tag in categoryGroup.Value.Take(8))
                                    {
                                        var isSelectedTag = Model.SelectedTags.Contains(tag.Name);
                                        <a class="btn btn-sm @tag.BadgeClass me-1 mb-1 tag-button @(isSelectedTag ? "active" : "")"
                                           asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.Filters.RouteWithTagToggled(tag.Name)"
                                           aria-pressed="@(isSelectedTag ? "true" : "false")">
                                            @CategoryLocalizationExtensions.LocalizeTagName(tag.Name, Localizer) <span class="badge bg-light text-dark ms-1">@tag.EventCount</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- All Popular Tags (fallback) -->
                        <div class="tag-cloud">
                            @foreach(var tag in Model.TopTags)
                            {
                                var isSelectedTag = Model.SelectedTags.Contains(tag.Name);
                                <a class="btn btn-sm @tag.BadgeClass me-1 mb-1 tag-button @tag.Size @(isSelectedTag ? "active" : "")"
                                   asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.Filters.RouteWithTagToggled(tag.Name)"
                                   aria-pressed="@(isSelectedTag ? "true" : "false")">
                                    @CategoryLocalizationExtensions.LocalizeTagName(tag.Name, Localizer) <span class="badge bg-light text-dark ms-1">@tag.EventCount</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Sorting Options: the chips wrap to new lines on narrow screens instead of running off the page (8.1) -->
    <div class="gs-sort-row">
        <span class="gs-chip-group-label" id="gs-sort-label">@Localizer["Events_SortBy"]</span>
        <ul class="gs-chip-row" aria-labelledby="gs-sort-label">
            @foreach(var sortOption in Model.LocalizedSortOptions)
            {
                var isCurrentSort = Model.SortBy == sortOption.Value;
                var newSortOrder = isCurrentSort && Model.SortOrder == "asc" ? "desc" : "asc";

                <li>
                    <a asp-controller="Events" asp-action="Index"
                       asp-all-route-data="@SortRoute(sortOption.Value, newSortOrder)"
                       class="gs-chip gs-chip-sm" aria-current="@(isCurrentSort ? "true" : null)">
                        <gs-icon name="@sortOption.IconName" />@sortOption.DisplayName
                        @if(isCurrentSort)
                        {
                            <gs-icon name="@(Model.SortOrder == "asc" ? "chevron-up" : "chevron-down")" />
                        }
                    </a>
                </li>
            }
        </ul>
    </div>
</section>

<!-- Results Section -->
<section class="py-4">
    <div class="container-grid">
        <!-- Events Grid: 4 / 3 / 2 / 1 columns (GS-REQ-008, 8.1) -->
        @if(Model.Events.Items.Any())
        {
            <ul class="gs-event-grid">
                @foreach(var eventItem in Model.Events.Items)
                {
                    <li><partial name="_EventCard" model="EventCardViewModel.FromEvent(eventItem)" /></li>
                }
            </ul>
        }
        else if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <div class="py-4">
                <h4 class="text-muted">@Localizer["Events_NoUpcomingForSearch", Model.SearchTerm]</h4>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <gs-icon name="calendar-x" class="text-muted" style="font-size: 4rem;" />
                <h4 class="mt-3 text-muted">@Localizer["Events_NoEventsFound"]</h4>
                <p class="text-muted">@Localizer["Events_NoEventsHint"]</p>
                <a href="/Events" class="gs-btn gs-btn-primary">@Localizer["Events_ViewAllEvents"]</a>
            </div>
        }

        @* Past search matches - shown below the last page of upcoming results. *@
        @if (Model.PastSearchResults.Any())
        {
            <h3 class="mt-5 mb-3">@Localizer["Events_PastEventsHeading"]</h3>
            <ul class="gs-event-grid">
                @foreach (var pastItem in Model.PastSearchResults)
                {
                    <li><partial name="_EventCard" model="EventCardViewModel.FromEvent(pastItem)" /></li>
                }
            </ul>
        }
        
        <!-- Pagination -->
        @if(Model.Events.TotalPages > 1)
        {
            <nav aria-label="Events pagination" class="mt-5">
                <ul class="pagination justify-content-center">
                    @if(Model.Events.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Events.CurrentPage - 1)&@Model.FiltersQueryString">
                                <gs-icon name="chevron-left" /> @Localizer["Events_Previous"]
                            </a>
                        </li>
                    }
                    
                    @for(var i = Math.Max(1, Model.Events.CurrentPage - 2); i <= Math.Min(Model.Events.TotalPages, Model.Events.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.Events.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&@Model.FiltersQueryString">@i</a>
                        </li>
                    }
                    
                    @if(Model.Events.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.Events.CurrentPage + 1)&@Model.FiltersQueryString">
                                @Localizer["Events_Next"] <gs-icon name="chevron-right" />
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/gs-events.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/gs-date-chip.js" asp-append-version="true" defer></script>

    <!-- Custom CSS for tag functionality -->
    <style>
        .tag-button.active {
            opacity: 0.8;
            box-shadow: 0 0 0 2px rgba(var(--bs-primary-rgb), 0.25);
        }
        
        .tag-link:hover {
            transform: translateY(-1px);
            transition: transform 0.2s;
        }
        
        .event-tags .badge {
            transition: all 0.2s;
        }
        
        .event-tags .badge:hover {
            transform: scale(1.05);
        }
        
        .autocomplete-item {
            padding: 8px;
        }
        
        .tag-cloud .btn {
            margin-right: 4px;
            margin-bottom: 4px;
        }
    </style>
}