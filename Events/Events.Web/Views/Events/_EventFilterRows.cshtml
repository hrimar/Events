@model Events.Web.Models.EventListFilters
@using System.Globalization
@using Events.Models.Enums
@using Events.Services.Time
@using Events.Web.Localization
@using Events.Web.Resources
@using Microsoft.AspNetCore.Routing
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject ISofiaClock SofiaClock

@* "When" and "Filters" rows of "All events", the same for the period view and the paged list (GS-REQ-008, 8.2.4,
   8.2.5). Every chip and filter is a link that changes only its own value; the "Date" chip opens gs-date-chip.js. *@
@{
    var culture = CultureInfo.CurrentCulture;
    var periods = new[] { EventPeriod.Today, EventPeriod.Tomorrow, EventPeriod.Weekend, EventPeriod.Next7 };

    string CategoryName(string value) =>
        Model.LocalizedCategories.FirstOrDefault(c => string.Equals(c.Value, value, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? value;

    var hasCategory = Model.SelectedCategories.Count > 0;
    var categoryText = hasCategory
        ? string.Join(", ", Model.SelectedCategories.Select(CategoryName))
        : Localizer["Events_FilterCategoryAll"].Value;
    var hasSubCategory = !string.IsNullOrEmpty(Model.SelectedSubCategory);
    var subCategoryText = hasSubCategory
        ? CategoryLocalizationExtensions.LocalizeSubCategoryName(Model.SelectedSubCategory!, Localizer)
        : null;
    var isFree = Model.IsFreeOnly;
    var freeText = Localizer["Events_FilterFreeOnly"].Value;
    var kidsText = Localizer["Events_FilterKids"].Value;
    var tagsText = string.Join(", ", Model.SelectedTags.Select(t => CategoryLocalizationExtensions.LocalizeTagName(t, Localizer)));
    var hasSearch = !string.IsNullOrWhiteSpace(Model.SearchTerm);

    // The picked day or range, so the calendar opens on it: "2026-11-05" or "2026-11-05,2026-11-20"
    var selectedDates = !Model.HasExplicitDates
        ? null
        : Model.FromDate == Model.ToDate
            ? Model.FromDate!.Value.ToString("yyyy-MM-dd")
            : $"{Model.FromDate!.Value:yyyy-MM-dd},{Model.ToDate!.Value:yyyy-MM-dd}";
}

<div class="gs-period-controls">
    @* "When": the hero chips (GS-REQ-007, 7.2); the current one is active with a check mark, a new one keeps the
       other filters (8.2.4) *@
    <div class="gs-period-row">
        <span class="gs-chip-group-label gs-period-row-label" id="gs-period-when">@Localizer["Home_HeroWhen"]</span>
        <ul class="gs-chip-row" aria-labelledby="gs-period-when">
            @foreach (var period in periods)
            {
                var isCurrent = Model.Period == period;
                <li>
                    <a class="gs-chip" asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.RouteWithPeriod(period)"
                       aria-current="@(isCurrent ? "true" : null)">
                        @period.Localize(Localizer)
                        @if (isCurrent)
                        {
                            <gs-icon name="check" />
                        }
                    </a>
                </li>
            }
            <li>
                @* Opens a calendar (gs-date-chip.js); the picked day keeps the other filters *@
                <button type="button" class="gs-chip" data-gs-date-chip aria-haspopup="dialog"
                        aria-current="@(Model.HasExplicitDates ? "true" : null)"
                        title="@Localizer["Home_ChipDateAria"]"
                        data-url="@Url.Action("Index", "Events", new RouteValueDictionary(Model.RouteWithoutDates()))"
                        data-min-date="@SofiaClock.Today.ToString("yyyy-MM-dd")"
                        data-range data-selected-date="@selectedDates"
                        data-locale="@(CultureHelper.IsEnglish() ? "en" : "bg")"
                        data-assets="@Url.Content("~/lib/flatpickr/dist")">
                    <gs-icon name="calendar" />
                    @(Model.HasExplicitDates ? EventCardFormatter.FormatDayRange(Model.FromDate!.Value, Model.ToDate!.Value, culture) : Localizer["Home_ChipDate"].Value)
                    @if (Model.HasExplicitDates)
                    {
                        <gs-icon name="check" />
                    }
                </button>
            </li>
        </ul>
    </div>

    @* "Filters": category, subcategory, free only, with kids; an active filter has the tag colour and a × that
       removes it. The only order in this view is by date and time (8.2.5). *@
    <div class="gs-period-row">
        <span class="gs-chip-group-label gs-period-row-label" id="gs-period-filters">@Localizer["Events_FiltersLabel"]</span>
        <ul class="gs-filter-row" aria-labelledby="gs-period-filters">
            <li class="dropdown gs-filter @(hasCategory ? "is-active" : "")">
                <button type="button" class="gs-filter-btn" data-bs-toggle="dropdown" aria-expanded="false">
                    @Localizer["Events_FilterCategoryLabel", categoryText]
                    <gs-icon name="chevron-down" />
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item @(hasCategory ? "" : "active")" asp-controller="Events" asp-action="Index"
                           asp-all-route-data="@Model.RouteWith("category", null)">@Localizer["Events_AllCategories"]</a>
                    </li>
                    @foreach (var category in Model.LocalizedCategories)
                    {
                        var isSelected = Model.SelectedCategories.Count == 1
                            && string.Equals(Model.SelectedCategories[0], category.Value, StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a class="dropdown-item @(isSelected ? "active" : "")" aria-current="@(isSelected ? "true" : null)"
                               asp-controller="Events" asp-action="Index"
                               asp-all-route-data="@Model.RouteWith("category", category.Value)">@category.DisplayName</a>
                        </li>
                    }
                </ul>
                @if (hasCategory)
                {
                    <a class="gs-filter-clear" asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.RouteWith("category", null)"
                       aria-label="@Localizer["Events_RemoveFilter", categoryText]"><gs-icon name="x" /></a>
                }
            </li>

            @* Subcategories belong to one category, so the menu is available only when exactly one is selected *@
            <li class="dropdown gs-filter @(hasSubCategory ? "is-active" : "")">
                @if (Model.AvailableSubCategories.Count > 0)
                {
                    <button type="button" class="gs-filter-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        @(hasSubCategory ? Localizer["Events_FilterSubCategoryLabel", subCategoryText!].Value : Localizer["Events_Subcategory"].Value)
                        <gs-icon name="chevron-down" />
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item @(hasSubCategory ? "" : "active")" asp-controller="Events" asp-action="Index"
                               asp-all-route-data="@Model.RouteWith("subCategory", null)">@Localizer["Events_AllSubcategories"]</a>
                        </li>
                        @foreach (var option in Model.AvailableSubCategories)
                        {
                            <li>
                                <a class="dropdown-item @(option.Selected ? "active" : "")" aria-current="@(option.Selected ? "true" : null)"
                                   asp-controller="Events" asp-action="Index"
                                   asp-all-route-data="@Model.RouteWith("subCategory", option.Value)">@option.Text</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <button type="button" class="gs-filter-btn" disabled title="@Localizer["Events_SelectCategoryFirst"]">
                        @Localizer["Events_Subcategory"]
                        <gs-icon name="chevron-down" />
                    </button>
                }
                @if (hasSubCategory)
                {
                    <a class="gs-filter-clear" asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.RouteWith("subCategory", null)"
                       aria-label="@Localizer["Events_RemoveFilter", subCategoryText!]"><gs-icon name="x" /></a>
                }
            </li>

            <li class="gs-filter @(isFree ? "is-active" : "")">
                <a class="gs-filter-btn" asp-controller="Events" asp-action="Index"
                   asp-all-route-data="@Model.RouteWith("free", isFree ? null : "true")"
                   aria-label="@(isFree ? Localizer["Events_RemoveFilter", freeText].Value : null)">
                    @freeText
                    @if (isFree)
                    {
                        <gs-icon name="x" />
                    }
                </a>
            </li>

            <li class="gs-filter @(Model.IsKidsFilter ? "is-active" : "")">
                <a class="gs-filter-btn" asp-controller="Events" asp-action="Index"
                   asp-all-route-data="@Model.RouteWith("kids", Model.IsKidsFilter ? null : "true")"
                   aria-label="@(Model.IsKidsFilter ? Localizer["Events_RemoveFilter", kidsText].Value : null)">
                    @kidsText
                    @if (Model.IsKidsFilter)
                    {
                        <gs-icon name="x" />
                    }
                </a>
            </li>

            @* A search from the header search (the paged list only); it can only be removed here *@
            @if (hasSearch)
            {
                <li class="gs-filter is-active">
                    <span class="gs-filter-btn">@Localizer["Events_FilterSearchLabel", Model.SearchTerm!]</span>
                    <a class="gs-filter-clear" asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.RouteWith("search", null)"
                       aria-label="@Localizer["Events_RemoveFilter", Model.SearchTerm!]"><gs-icon name="x" /></a>
                </li>
            }

            @* Tags come from a homepage quick filter or the tag cloud (e.g. "Jazz"); they can only be removed here *@
            @if (Model.SelectedTags.Count > 0)
            {
                <li class="gs-filter is-active">
                    <span class="gs-filter-btn">@Localizer["Events_FilterTagsLabel", tagsText]</span>
                    <a class="gs-filter-clear" asp-controller="Events" asp-action="Index" asp-all-route-data="@Model.RouteWith("tags", null)"
                       aria-label="@Localizer["Events_RemoveFilter", tagsText]"><gs-icon name="x" /></a>
                </li>
            }
        </ul>
        @if (Model.HasFixedSort)
        {
            <p class="gs-period-sort">@Localizer["Events_SortLabel"] <strong>@Localizer["Events_SortDateTime"]</strong></p>
        }
    </div>
</div>
