@model IEnumerable<Events.Web.Models.VenueListItemViewModel>
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@{
    // Title/MetaDescription are set in VenuesController.Index (default + admin PageSeoMeta
    // override) - not clobbered here.
    var search = ViewBag.Search as string;
}

<section class="gs-page-header">
    <div class="container-grid">
        <h1 class="gs-h1 mb-2">@Localizer["Venue_IndexTitle"]</h1>
        <p class="gs-lead mb-0">@Localizer["Venue_IndexSubtitle"]</p>
    </div>
</section>

<section class="py-4">
    <div class="container-grid">

        <!-- Search -->
        <form method="get" class="mb-4" role="search" style="max-width:420px;">
            <label class="gs-search">
                <gs-icon name="search" size="18" />
                <input type="search" name="search" value="@search"
                       placeholder="@Localizer["Venue_SearchPlaceholder"]" aria-label="@Localizer["Venue_SearchPlaceholder"]" />
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="Index" class="gs-search-clear" aria-label="@Localizer["Events_ClearAll"]" title="@Localizer["Events_ClearAll"]">
                        <gs-icon name="x" size="18" />
                    </a>
                }
            </label>
        </form>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <gs-icon name="map-pin" size="48" class="mb-3 opacity-50" />
                <p>@Localizer["Venue_NoVenuesFound"]</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var venue in Model)
                {
                    <div class="col">
                        <a asp-action="Details" asp-route-slug="@venue.Slug"
                           class="text-decoration-none">
                            <div class="card h-100 shadow-sm border-0 venue-card">
                                @if (!string.IsNullOrEmpty(venue.PhotoUrl))
                                {
                                    <img src="@venue.PhotoUrl" alt="@venue.DisplayName"
                                         class="card-img-top"
                                         style="height:160px; object-fit:cover;"
                                         onerror="this.style.display='none'">
                                }
                                else
                                {
                                    <div class="bg-surface-alt d-flex align-items-center justify-content-center"
                                         style="height:160px;">
                                        <gs-icon name="map-pin" size="48" class="text-muted opacity-50" />
                                    </div>
                                }
                                <div class="card-body">
                                    <h5 class="card-title text-body mb-1">@venue.DisplayName</h5>
                                    @if (!string.IsNullOrEmpty(venue.ShortName))
                                    {
                                        <span class="badge bg-secondary mb-2">@venue.ShortName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(venue.City))
                                    {
                                        <div class="text-muted small">
                                            <gs-icon name="building-2" class="me-1" />@venue.City
                                        </div>
                                    }
                                </div>
                                @if (venue.UpcomingEventsCount > 0)
                                {
                                    <div class="card-footer bg-transparent border-0 pt-0">
                                        <span class="gs-tag">
                                            @venue.UpcomingEventsCount @Localizer["Venue_UpcomingEventsCount"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Styles {
    <style>
        .venue-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .venue-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        }
    </style>
}
