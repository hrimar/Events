@model Events.Web.Models.HomePageViewModel
@using Events.Web.Infrastructure

@* Title/MetaDescription are set in HomeController.Index (default + admin PageSeoMeta
   override) - not here, so this view doesn't clobber the admin-configured value. *@

@* The server picks the layout by device class (phone or not), so a phone never receives
   the desktop-only sections (GS-REQ-007, general requirement 1). *@
@if (Model.DeviceClass == DeviceClass.Mobile)
{
    <partial name="_HomeMobile" model="Model" />
}
else
{
    <partial name="_HomeDesktop" model="Model" />
}

@section Scripts {
    @if (Model.DeviceClass == DeviceClass.Desktop)
    {
        <script src="~/js/home.js" asp-append-version="true" defer></script>
        <script src="~/js/gs-date-chip.js" asp-append-version="true" defer></script>
    }
}

@section Styles {
    @if (Model.DeviceClass == DeviceClass.Desktop)
    {
        <link rel="stylesheet" href="~/css/gs-home.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/gs-home-mobile.css" asp-append-version="true" />
    }
}
