@model Events.Web.Models.HomeVenuesViewModel
@using Events.Web.Localization
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@* "Venues" (GS-REQ-007, 7.10): the 4 venues with a photo and the most events in the next 30 days. *@
@{
    var isEnglish = CultureHelper.IsEnglish();
}

<section class="gs-home-section" aria-labelledby="gs-venues-title">
    <div class="container-grid">
        <div class="gs-section-head">
            <div class="gs-section-titles">
                <p class="gs-eyebrow">@Localizer["Home_VenuesEyebrow", Model.TotalCount]</p>
                <h2 id="gs-venues-title" class="gs-h2 gs-section-title">@Localizer["Home_VenuesHeading"]</h2>
            </div>
            <div class="gs-section-actions">
                @* Secondary button style (GS-REQ-007, 7.10.1) *@
                <a class="gs-btn gs-btn-secondary" asp-controller="Venues" asp-action="Index">@Localizer["Home_VenuesAll", Model.TotalCount]</a>
            </div>
        </div>

        <ul class="gs-venue-grid">
            @foreach (var venue in Model.Venues)
            {
                var name = venue.LocalizedName(isEnglish);
                <li>
                    <partial name="_VenueCard" model="new VenueCardViewModel(venue.Slug, name, venue.PhotoUrl, venue.UpcomingEventsCount)" />
                </li>
            }
        </ul>
    </div>
</section>
