@model Events.Web.Models.HomePageViewModel
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject Events.Services.Time.ISofiaClock SofiaClock
@{
    var sofiaToday = SofiaClock.Today;
}

<!-- Statistics Section -->
<section class="bg-surface-alt py-2">
    <div class="container-grid">
        <div class="row text-center justify-content-center">
            <div class="col-md-2">
                <a asp-action="Index" asp-controller="Events" class="text-decoration-none text-body stat-card">
                    <h3 class="text-primary">@Model.TotalEvents</h3>
                    <p class="text-muted mb-0">@Localizer["Home_TotalEvents"]</p>
                </a>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" asp-controller="Events"
                   asp-route-fromDate="@sofiaToday.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@sofiaToday.ToString("yyyy-MM-dd")"
                   class="text-decoration-none text-body stat-card">
                    <h3 class="text-success">@Model.TodayEvents</h3>
                    <p class="text-muted mb-0">@Localizer["Home_TodayEvents"]</p>
                </a>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" asp-controller="Events"
                   asp-route-fromDate="@sofiaToday.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@sofiaToday.AddDays(6).ToString("yyyy-MM-dd")"
                   class="text-decoration-none text-body stat-card">
                    <h3 class="text-info">@Model.Next7DaysEvents</h3>
                    <p class="text-muted mb-0">@Localizer["Home_Next7Days"]</p>
                </a>
            </div>
        </div>
    </div>
</section>
