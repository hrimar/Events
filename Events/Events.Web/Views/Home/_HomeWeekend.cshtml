@model Events.Web.Models.HomeWeekendViewModel
@using System.Globalization
@using Events.Models.Enums
@using Events.Services.Time
@using Events.Web.Localization
@using Events.Web.Models
@using Events.Web.Resources
@using Events.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@* "This weekend" band (GS-REQ-007, 7.6): day tabs and filter chips reload the grid in place (home.js). *@
@{
    var culture = CultureInfo.CurrentCulture;
    var filters = new[]
    {
        (Filter: HomeWeekendFilter.All, Label: Localizer["Home_WeekendFilterAll"].Value),
        (Filter: HomeWeekendFilter.Morning, Label: Localizer["Home_WeekendFilterMorning"].Value),
        (Filter: HomeWeekendFilter.Evening, Label: Localizer["Home_WeekendFilterEvening"].Value),
        (Filter: HomeWeekendFilter.Kids, Label: Localizer["Home_WeekendFilterKids"].Value)
    };
}

<section class="gs-home-section gs-home-band" aria-labelledby="gs-weekend-title"
         data-gs-weekend data-url="@Url.Action("WeekendEvents", "Home")">
    <div class="container-grid">
        <div class="gs-section-head">
            <div class="gs-section-titles">
                <p class="gs-eyebrow">@EventCardFormatter.FormatDayRange(Model.FromDate, Model.ToDate, culture)</p>
                <h2 id="gs-weekend-title" class="gs-h2 gs-section-title">@Localizer["Home_WeekendHeading"]</h2>
            </div>
            <div class="gs-section-actions">
                <a class="gs-section-link" asp-controller="Events" asp-action="Index"
                   asp-route-period="@EventPeriodCalculator.ToQueryValue(EventPeriod.Weekend)">@Localizer["Home_WeekendAll"]</a>
            </div>
        </div>

        <div class="gs-weekend-bar">
            <div class="gs-tabs" role="tablist" aria-label="@Localizer["Home_WeekendDays"]">
                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var day = Model.Days[i];
                    var isSelected = i == 0;
                    <button type="button" class="gs-tab" role="tab" id="gs-weekend-tab-@i"
                            aria-selected="@(isSelected ? "true" : "false")" aria-controls="gs-weekend-panel"
                            tabindex="@(isSelected ? "0" : "-1")" data-day="@day.ToString("yyyy-MM-dd")">
                        @EventCardFormatter.FormatWeekdayAndShortMonth(day, culture)
                    </button>
                }
            </div>
            <div class="gs-chip-row gs-weekend-filters" role="group" aria-label="@Localizer["Home_WeekendFilters"]">
                @foreach (var item in filters)
                {
                    <button type="button" class="gs-chip gs-chip-compact" data-filter="@HomeWeekendSelector.ToQueryValue(item.Filter)"
                            aria-pressed="@(item.Filter == HomeWeekendFilter.All ? "true" : "false")">@item.Label</button>
                }
            </div>
        </div>

        <div id="gs-weekend-panel" role="tabpanel" aria-labelledby="gs-weekend-tab-0" data-gs-weekend-panel>
            <partial name="_HomeWeekendCards" model="Model.FirstPage" />
        </div>

        <p class="gs-weekend-error" role="alert" data-gs-weekend-error hidden>@Localizer["Home_LoadError"]</p>

        <div class="gs-weekend-more">
            <button type="button" class="gs-btn gs-btn-secondary" data-gs-weekend-more hidden="@(!Model.FirstPage.HasMore)">
                @Localizer["Home_ShowMore"]
            </button>
        </div>
    </div>
</section>
