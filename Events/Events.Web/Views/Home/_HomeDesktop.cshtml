@model Events.Web.Models.HomePageViewModel
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@* Desktop and tablet layout. Still the previous homepage: its sections are replaced one by one
   with the new ones in GS-REQ-007 steps 7d-7j. *@

<!-- Hero Section (hidden on mobile - its links live in the hamburger menu; keeps focus on Weekly Events) -->
<section class="bg-primary text-white py-2 d-none d-md-block">
    <div class="container-grid">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="home-hero-title">@Model.HeroTitle</h1>
                <p class="home-hero-subtitle">@Model.HeroSubtitle</p>
                
                <!-- Main CTA to Events Page -->
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Index" asp-controller="Events" class="btn btn-light btn-sm">
                        <gs-icon name="search" class="me-2" />@Localizer["Home_BrowseAll"]
                    </a>
                    <a asp-action="Index" asp-controller="Venues" class="btn btn-outline-light btn-sm">
                        <gs-icon name="map-pin" class="me-2" />@Localizer["Venue_BrowseVenues"]
                    </a>
                    <a asp-action="Index" asp-controller="Events" asp-route-free="true" class="btn btn-success btn-sm">
                        <gs-icon name="gift" class="me-2" />@Localizer["Home_FreeEvents"]
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <gs-icon name="calendar-days" class="home-hero-icon" />
            </div>
        </div>
    </div>
</section>

<!-- Quick Category Navigation -->
<section class="py-1 bg-surface-alt d-none d-md-block">
    <div class="container-grid">
        <h2 class="home-section-title text-center mb-2">@Localizer["Home_BrowseByCategory"]</h2>
        <div class="home-category-grid">
            @foreach(var category in Model.LocalizedCategories)
            {
                <a asp-action="Index" asp-controller="Events" asp-route-category="@category.Value"
                   class="btn btn-outline-primary home-category-tile d-flex flex-column align-items-center justify-content-center text-decoration-none">
                    <gs-icon name="@category.IconName" />
                    <span>@category.DisplayName</span>
                </a>
            }
        </div>
    </div>
</section>

@* <!-- Popular Tags Section -->
@if(Model.PopularTags.Any())
{
    <section class="py-4 bg-white border-top border-bottom">
        <div class="container">
            <div class="row align-items-center mb-4">
                <div class="col-md-6">
                    <h3 class="mb-0">
                        <gs-icon name="tags" class="text-info me-2" />
                        Popular Event Tags
                    </h3>
                    <p class="text-muted mb-0">Discover events by popular themes and topics</p>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-action="Index" asp-controller="Events" class="btn btn-outline-info">
                        <gs-icon name="layout-grid" class="me-1" />View All Events
                    </a>
                </div>
            </div>
            
            <div class="tag-cloud-home">
                @foreach(var tag in Model.PopularTags)
                {
                    <a asp-action="ByTag" asp-controller="Events" asp-route-tagName="@tag.Name"
                       class="btn @tag.BadgeClass me-2 mb-2 tag-home-link @tag.Size text-decoration-none">
                        <gs-icon name="tag" class="me-1" />@tag.Name
                        <span class="badge bg-light text-dark ms-1">@tag.EventCount</span>
                    </a>
                }
            </div>
            
            <div class="text-center mt-3">
                <small class="text-muted">
                    <gs-icon name="info" class="me-1" />
                    Click on any tag to find events with that theme
                </small>
            </div>
        </div>
    </section>
} *@

<!-- Weekly Events -->
@await Html.PartialAsync("_WeeklyEvents", Model.WeeklyEvents)

<partial name="_HomeUserSections" model="Model" />

<partial name="_HomeStats" model="Model" />
