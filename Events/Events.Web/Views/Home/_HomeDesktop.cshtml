@model Events.Web.Models.HomePageViewModel

@* Desktop and tablet layout (GS-REQ-007, structure table): hero, Tonight, This weekend, Don't miss,
   Browse by interest, Free this week, Venues. It replaces the previous "This week" block and the stats row
   (00-kontekst, "Заменя се на десктоп"); both stay in the mobile layout. *@

@* Hero (GS-REQ-007, 7.1-7.4): replaces the blue hero and the 13 category buttons (GS-REQ-005, 5.1 and 5.6) *@
@if (Model.Hero != null)
{
    <partial name="_HomeHero" model="Model.Hero" />
}

@* Tonight (GS-REQ-007, 7.5); not rendered when no event of today or tomorrow is left *@
@if (Model.Tonight != null)
{
    <partial name="_HomeTonight" model="Model.Tonight" />
}

@* This weekend (GS-REQ-007, 7.6); not rendered when the weekend has no events *@
@if (Model.Weekend != null)
{
    <partial name="_HomeWeekend" model="Model.Weekend" />
}

@* Don't miss (GS-REQ-007, 7.7); not rendered when there are no featured events after the carousel *@
@if (Model.DontMiss.Any())
{
    <partial name="_HomeDontMiss" model="Model.DontMiss" />
}

@* Browse by interest (GS-REQ-007, 7.8); not rendered when no category has events in the next 30 days *@
@if (Model.Interests.Any())
{
    <partial name="_HomeInterests" model="Model.Interests" />
}

@* Free this week (GS-REQ-007, 7.9); not rendered with fewer than 3 free events in the next 7 days *@
@if (Model.FreeThisWeek != null)
{
    <partial name="_HomeFreeThisWeek" model="Model.FreeThisWeek" />
}

@* Venues (GS-REQ-007, 7.10); not rendered when no venue with a photo has events in the next 30 days *@
@if (Model.Venues != null)
{
    <partial name="_HomeVenues" model="Model.Venues" />
}

@* <!-- Popular Tags Section -->
@if(Model.PopularTags.Any())
{
    <section class="py-4 bg-white border-top border-bottom">
        <div class="container">
            <div class="row align-items-center mb-4">
                <div class="col-md-6">
                    <h3 class="mb-0">
                        <gs-icon name="tags" class="text-info me-2" />
                        Popular Event Tags
                    </h3>
                    <p class="text-muted mb-0">Discover events by popular themes and topics</p>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-action="Index" asp-controller="Events" class="btn btn-outline-info">
                        <gs-icon name="layout-grid" class="me-1" />View All Events
                    </a>
                </div>
            </div>
            
            <div class="tag-cloud-home">
                @foreach(var tag in Model.PopularTags)
                {
                    <a asp-action="ByTag" asp-controller="Events" asp-route-tagName="@tag.Name"
                       class="btn @tag.BadgeClass me-2 mb-2 tag-home-link @tag.Size text-decoration-none">
                        <gs-icon name="tag" class="me-1" />@tag.Name
                        <span class="badge bg-light text-dark ms-1">@tag.EventCount</span>
                    </a>
                }
            </div>
            
            <div class="text-center mt-3">
                <small class="text-muted">
                    <gs-icon name="info" class="me-1" />
                    Click on any tag to find events with that theme
                </small>
            </div>
        </div>
    </section>
} *@

@* Saved and recommended events of a signed-in user *@
<partial name="_HomeUserSections" model="Model" />
