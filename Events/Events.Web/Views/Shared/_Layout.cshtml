@using Events.Models.Enums
@using Events.Web.Infrastructure
@using Events.Web.Models
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@inject ISiteUrlProvider SiteUrlProvider

<!-- hreflang alternates are intentionally omitted: bg/en is switched via a cookie
     (LanguageController + CookieRequestCultureProvider), not via distinct per-language
     URLs, so there is no separate crawlable URL for hreflang to point to. Emitting
     hreflang tags that both resolve to the same URL would assert content Google can't
     actually verify. Revisit only if URL-based localization is introduced. -->
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <!-- Google Analytics tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NL0QFW80H6"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-NL0QFW80H6');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function () {
            var t = localStorage.getItem('selectedTheme');
            if (!t) {
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
            // Bootstrap 5.3 color modes: keeps Bootstrap components (forms, dropdowns, modals) in the same theme
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <title>@(ViewData["PageTitle"] ?? ViewData["Title"])</title>
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? SiteUrlProvider.BuildAbsoluteUrl(Context.Request.Path))" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sofia+Sans:wght@400;500;600;700;800&family=Sofia+Sans+Condensed:wght@700;800&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Theme CSS Files -->
    <link rel="stylesheet" href="~/css/themes/light-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/dark-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/events-portal.css" asp-append-version="true" />

    <!-- Go Sofia visual system (GS-REQ-006): loaded last so the tokens and base styles take precedence -->
    <link rel="stylesheet" href="~/css/gs-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gs-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gs-components.css" asp-append-version="true" />
    
    <!-- Open Graph / Twitter Card meta tags for social sharing - single source of truth,
         driven by ViewData so no view needs its own duplicate MetaTags OG block. -->
    @await RenderSectionAsync("MetaTags", required: false)
    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
        <meta property="og:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"])" />
        <meta property="og:description" content="@ViewData["MetaDescription"]" />
        @if (!string.IsNullOrEmpty(ViewData["OgImageUrl"]?.ToString()))
        {
            <meta property="og:image" content="@ViewData["OgImageUrl"]" />
        }
        @if (!string.IsNullOrEmpty(ViewData["OgUrl"]?.ToString()))
        {
            <meta property="og:url" content="@ViewData["OgUrl"]" />
        }
        <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
        <meta property="og:site_name" content="Go Sofia" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"])" />
        <meta name="twitter:description" content="@ViewData["MetaDescription"]" />
        @if (!string.IsNullOrEmpty(ViewData["OgImageUrl"]?.ToString()))
        {
            <meta name="twitter:image" content="@ViewData["OgImageUrl"]" />
        }
    }
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
@* Header (GS-REQ-006, 6.6): full row from 1200px (desktop), hamburger menu below *@
<nav class="navbar navbar-expand-xl gs-header" aria-label="@Localizer["Nav_MainNavigation"]">
    <div class="container-grid">
        <a class="navbar-brand gs-logo" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.jpeg" alt="Go Sofia" width="95" height="40" loading="eager" decoding="async" fetchpriority="high" />
        </a>

        <!-- Mobile/Tablet controls: search toggle + hamburger, kept on a single row with the logo -->
        <div class="d-flex align-items-center gap-1 d-xl-none">
            <button class="gs-icon-btn" type="button" data-bs-toggle="collapse" data-bs-target="#mobile-search-bar"
                    aria-expanded="false" aria-controls="mobile-search-bar" aria-label="@Localizer["Nav_SearchPlaceholderMobile"]">
                <gs-icon name="search" size="20" />
            </button>
            <button class="gs-icon-btn" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="@Localizer["Nav_Menu"]">
                <gs-icon name="menu" size="22" />
            </button>
        </div>

        <div class="navbar-collapse collapse" id="navbarNav">
            <ul class="navbar-nav gs-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index">@Localizer["Nav_AllEvents"]</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @Localizer["Nav_Categories"]
                    </a>
                    <ul class="dropdown-menu">
                        @foreach(var category in EventsPageViewModel.GetAvailableCategories(Localizer))
                        {
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Events"
                                   asp-action="Index" asp-route-category="@category.Value">
                                    <i class="@category.IconClass me-2"></i>@category.DisplayName
                                </a>
                            </li>
                        }
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Venues" asp-action="Index">@Localizer["Venue_BrowseVenues"]</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index" asp-route-free="true">
                        @Localizer["Nav_Free"]
                    </a>
                </li>
            </ul>

            <!-- Desktop search with autocomplete -->
            <div class="gs-header-search d-none d-xl-block position-relative">
                <form asp-area="" asp-controller="Events" asp-action="Index" method="get" role="search">
                    <label class="gs-search">
                        <gs-icon name="search" size="18" />
                        <input type="search" name="search" id="navbar-search" autocomplete="off"
                               placeholder="@Localizer["Nav_SearchPlaceholder"]" aria-label="@Localizer["Nav_SearchPlaceholder"]">
                    </label>
                </form>
                <!-- Hidden autocomplete container -->
                <div id="navbar-search-results" class="position-absolute top-100 start-0 w-100 theme-dropdown border rounded-bottom shadow-lg" style="display: none; z-index: 1000; max-height: 420px; overflow-y: auto;"
                     data-label-events="@Localizer["Search_GroupEvents"]" data-label-venues="@Localizer["Search_GroupVenues"]"></div>
            </div>

            <div class="gs-header-actions">
                <partial name="_ThemeSwitcher" />
                <partial name="_LanguageSwitcher" view-data='new ViewDataDictionary(ViewData) { { "OtherLanguageOnly", true } }' />
                <partial name="_LoginPartial" />
            </div>
        </div>

        <!-- Mobile Search Bar: collapsed by default, expanded via the search icon next to the hamburger -->
        <div class="collapse d-xl-none w-100 mt-2 border-top pt-2" id="mobile-search-bar">
            <form asp-area="" asp-controller="Events" asp-action="Index" method="get" role="search">
                <label class="gs-search">
                    <gs-icon name="search" size="18" />
                    <input type="search" name="search" id="mobile-navbar-search" autocomplete="off"
                           placeholder="@Localizer["Nav_SearchPlaceholder"]" aria-label="@Localizer["Nav_SearchPlaceholder"]">
                </label>
            </form>
            <div id="mobile-navbar-search-results" class="position-absolute w-100 theme-dropdown border rounded shadow-lg mt-1" style="display: none; z-index: 1000; max-height: 420px; overflow-y: auto; margin-left: -12px; margin-right: -12px; max-width: calc(100% + 24px);"
                 data-label-events="@Localizer["Search_GroupEvents"]" data-label-venues="@Localizer["Search_GroupVenues"]"></div>
        </div>
        
    </div>
</nav>

<main>
    @RenderBody()
</main>

<!-- Footer -->
@* Footer: the 3-column structure is kept, with the new colors (GS-REQ-006) *@
<footer class="gs-footer py-4 mt-5">
    <div class="container-grid">
        <div class="row gy-4">
            <!-- Brand -->
            <div class="col-md-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="d-inline-block mb-2">
                    <img src="~/images/logo.jpeg" alt="Go Sofia" class="footer-logo" width="160" height="56" loading="lazy" decoding="async" />
                </a>
                <p class="mb-3">@Localizer["Footer_Description"]</p>
                <a href="https://www.facebook.com/GoSofia" target="_blank" rel="noopener noreferrer"
                   class="gs-footer-link" aria-label="Facebook" title="Facebook">
                    <gs-icon name="facebook" size="20" />
                </a>
            </div>

            <!-- Explore -->
            <div class="col-6 col-md-4">
                <h2 class="gs-footer-heading">@Localizer["Footer_ExploreHeading"]</h2>
                <div class="d-flex flex-column gap-2">
                    <a asp-area="" asp-controller="Events" asp-action="Index" class="gs-footer-link">
                        @Localizer["Nav_AllEvents"]
                    </a>
                    <a asp-area="" asp-controller="Venues" asp-action="Index" class="gs-footer-link">
                        @Localizer["Venue_BrowseVenues"]
                    </a>
                    <a asp-area="" asp-controller="Events" asp-action="Index" asp-route-free="true" class="gs-footer-link">
                        @Localizer["Home_FreeEvents"]
                    </a>
                </div>
            </div>

            <!-- Information -->
            <div class="col-6 col-md-4">
                <h2 class="gs-footer-heading">@Localizer["Footer_InfoHeading"]</h2>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Home" asp-action="AboutUs" class="gs-footer-link">
                        @Localizer["Footer_AboutUs"]
                    </a>
                    <a asp-controller="Home" asp-action="Privacy" class="gs-footer-link">
                        @Localizer["Footer_PrivacyPolicy"]
                    </a>
                    <a asp-controller="Contact" asp-action="Index" class="gs-footer-link">
                        @Localizer["Footer_ContactUs"]
                    </a>
                    <a href="mailto:office@go-sofia.com" class="gs-footer-link">
                        <gs-icon name="mail" class="me-1" />office@go-sofia.com
                    </a>
                </div>
            </div>
        </div>

        <hr class="gs-footer-divider my-3" />

        <div class="row align-items-center">
            <div class="col-md-6">
                <small>&copy; @DateTime.Now.Year Go Sofia. @Localizer["Footer_Copyright"]</small>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end mt-2 mt-md-0">
                <partial name="_LanguageSwitcher" />
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/theme-switcher.js" asp-append-version="true"></script>

<!-- Enhanced Navigation Search Script -->
<script>
$(document).ready(function() {
    initializeSearch('#navbar-search', '#navbar-search-results');
    initializeSearch('#mobile-navbar-search', '#mobile-navbar-search-results');

    // Focus the mobile search field once it expands after tapping the search icon
    document.getElementById('mobile-search-bar')?.addEventListener('shown.bs.collapse', function () {
        document.getElementById('mobile-navbar-search')?.focus();
    });

    // Event and venue names come from external sources - never insert them as raw HTML.
    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function initializeSearch(searchInputSelector, resultsContainerSelector) {
        let searchTimeout;
        const searchInput = $(searchInputSelector);
        const resultsContainer = $(resultsContainerSelector);

        searchInput.on('input', function() {
            clearTimeout(searchTimeout);
            const query = $(this).val().trim();

            if (query.length >= 2) {
                searchTimeout = setTimeout(() => {
                    performSearch(query);
                }, 300);
            } else {
                resultsContainer.hide();
            }
        });

        // Hide results when clicking outside
        $(document).on('click', function(e) {
            const isClickInsideSearch = $(e.target).closest(searchInputSelector).length > 0 ||
                                       $(e.target).closest(resultsContainerSelector).length > 0;
            if (!isClickInsideSearch) {
                resultsContainer.hide();
            }
        });

        function performSearch(query) {
            $.ajax({
                url: '/Events/Search',
                data: { query: query },
                success: function(data) {
                    displaySearchResults(data);
                },
                error: function() {
                    resultsContainer.hide();
                }
            });
        }

        // Group labels are localized on the server (data-label-* attributes on the results container).
        function renderGroup(label, items, iconClass) {
            let html = `<div class="mb-1"><small class="text-muted fw-bold">${escapeHtml(label)}</small></div>`;
            items.forEach(item => {
                html += `
                    <a class="navbar-search-item d-block p-2 rounded hover-bg-surface text-decoration-none text-body"
                       href="${escapeHtml(item.url)}">
                        <i class="${iconClass} me-2"></i>
                        <strong>${escapeHtml(item.title)}</strong><br>
                        <small class="text-muted">${item.category ? escapeHtml(item.category) + ' • ' : ''}${escapeHtml(item.details)}</small>
                    </a>`;
            });
            return html;
        }

        function displaySearchResults(data) {
            const events = data?.events ?? [];
            const venues = data?.venues ?? [];

            if (events.length === 0 && venues.length === 0) {
                resultsContainer.hide();
                return;
            }

            let html = '<div class="p-2">';

            if (events.length > 0) {
                html += renderGroup(resultsContainer.data('label-events'), events, 'fas fa-calendar text-primary');
            }

            if (venues.length > 0) {
                if (events.length > 0) {
                    html += '<hr class="my-2">';
                }
                html += renderGroup(resultsContainer.data('label-venues'), venues, 'fas fa-map-marker-alt text-primary');
            }

            html += '</div>';
            resultsContainer.html(html).show();
        }
    }
});
</script>

<style>
    .hover-bg-surface:hover {
        background-color: var(--hover-bg) !important;
    }
    
    .cursor-pointer {
        cursor: pointer;
    }
    
    .navbar-search-item {
        transition: background-color 0.2s ease;
    }

</style>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>