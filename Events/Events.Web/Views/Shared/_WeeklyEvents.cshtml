@model Events.Web.Models.WeeklyEventsViewModel
@using Events.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@* "This week" block of the mobile homepage (GS-REQ-007, step 7k): the layout is kept (day chips and the four tabs),
   built from the new components (GS-REQ-006, 6.5). Content is stacked vertically; only the day chips strip scrolls
   sideways (general requirement 2). Also returned by Home/WeeklyEventsPartial for the period arrows. *@
@{
    var displayCulture = System.Globalization.CultureInfo.CurrentCulture;
    var allDayNames = displayCulture.DateTimeFormat.AbbreviatedDayNames;
    var calDayNames = new[] { allDayNames[1], allDayNames[2], allDayNames[3], allDayNames[4], allDayNames[5], allDayNames[6], allDayNames[0] };

    // The block shows 6 days (Home/WeeklyEventsPartial loads fromDate .. fromDate + 5); the arrows move by 6.
    const int dayCount = 6;
    const int maxCategoryCards = 8;
    var prevFrom = Model.FromDate.AddDays(-dayCount).ToString("yyyy-MM-dd");
    var nextFrom = Model.FromDate.AddDays(dayCount).ToString("yyyy-MM-dd");
    var todayFrom = Model.Today.ToString("yyyy-MM-dd");
    var isCurrentWeek = Model.FromDate.Date == Model.Today.Date;
    var periodLabel = Model.FromDate.ToString("d MMM", displayCulture) + " – "
        + Model.FromDate.AddDays(dayCount - 1).ToString("d MMM yyyy", displayCulture);
    var sectionTitle = isCurrentWeek ? Localizer["Home_WeeklySectionTitle"].Value : Localizer["Home_UpcomingSectionTitle"].Value;

    var dayList = Model.ByDay;
    int todayIndex = dayList.FindIndex(d => d.IsToday);
    int activeDayIndex = todayIndex >= 0 ? todayIndex : 0;
}

<section class="gs-home-section gs-weekly" id="weekly-events-section" aria-labelledby="gs-weekly-title">
    <div class="container-grid">
        <div class="gs-section-head">
            <div class="gs-section-titles">
                <h2 id="gs-weekly-title" class="gs-h2 gs-section-title">@sectionTitle</h2>
            </div>
            <div class="gs-section-actions">
                <a asp-controller="Events" asp-action="Index" class="gs-section-link">@Localizer["Home_ViewAllEvents"]</a>
            </div>
        </div>

        @* Period: previous / next 6 days, back to this week *@
        <div class="gs-weekly-period">
            <button type="button" class="gs-row-arrow week-nav-btn" data-from="@prevFrom" aria-label="@Localizer["Home_PreviousDays"]">
                <gs-icon name="chevron-left" />
            </button>
            <span class="gs-weekly-period-label">@periodLabel</span>
            <button type="button" class="gs-row-arrow week-nav-btn" data-from="@nextFrom" aria-label="@Localizer["Home_NextDays"]">
                <gs-icon name="chevron-right" />
            </button>
            @if (!isCurrentWeek)
            {
                <button type="button" class="gs-chip gs-chip-compact week-nav-btn" data-from="@todayFrom">@Localizer["Home_ThisWeek"]</button>
            }
        </div>

        <div class="gs-tabs gs-weekly-tabs" id="weeklyTabs" role="tablist" aria-label="@Localizer["Home_WeeklyViews"]">
            @* Bootstrap Tab finds the current tab by the "active" class (aria-selected alone is not enough) *@
            <button type="button" class="gs-tab active" id="tab-day-btn" role="tab" data-bs-toggle="tab" data-bs-target="#tab-day"
                    aria-controls="tab-day" aria-selected="true">@Localizer["Home_TabByDay"]</button>
            <button type="button" class="gs-tab" id="tab-cat-btn" role="tab" data-bs-toggle="tab" data-bs-target="#tab-cat"
                    aria-controls="tab-cat" aria-selected="false" tabindex="-1">@Localizer["Home_TabByCategory"]</button>
            <button type="button" class="gs-tab" id="tab-weekend-btn" role="tab" data-bs-toggle="tab" data-bs-target="#tab-weekend"
                    aria-controls="tab-weekend" aria-selected="false" tabindex="-1">@Localizer["Home_TabWeekend"]</button>
            <button type="button" class="gs-tab" id="tab-cal-btn" role="tab" data-bs-toggle="tab" data-bs-target="#tab-cal"
                    aria-controls="tab-cal" aria-selected="false" tabindex="-1">@Localizer["Home_TabCalendar"]</button>
        </div>

        <div class="tab-content" id="weeklyTabsContent">

            <!-- TAB 1: By day - day chips + the day's events -->
            <div class="tab-pane fade show active" id="tab-day" role="tabpanel" aria-labelledby="tab-day-btn">
                @* The 6 days share the width, so nothing scrolls sideways (general requirement 2) *@
                <div class="gs-day-chips" role="group" aria-label="@Localizer["Home_TabByDay"]" data-gs-day-chips>
                    @for (int i = 0; i < dayList.Count; i++)
                    {
                        var day = dayList[i];
                        var isActive = i == activeDayIndex;
                        <button type="button" class="gs-day-chip" data-day-index="@i" aria-pressed="@(isActive ? "true" : "false")">
                            <span class="gs-day-chip-name">
                                @(day.IsToday ? Localizer["Home_Today"].Value : day.Date.ToString("ddd", displayCulture))
                            </span>
                            <span class="gs-day-chip-number">@day.Date.Day</span>
                            <span class="gs-day-chip-count">@day.Events.Count</span>
                        </button>
                    }
                </div>

                @for (int i = 0; i < dayList.Count; i++)
                {
                    var day = dayList[i];
                    <div class="gs-day-panel" data-day-index="@i" hidden="@(i != activeDayIndex)">
                        @if (!day.Events.Any())
                        {
                            <p class="gs-weekly-empty">@Localizer["Home_NoEventsForDay"]</p>
                        }
                        else
                        {
                            <ul class="gs-weekly-list">
                                @foreach (var ev in day.Events)
                                {
                                    @* One day, so the cards show just the time *@
                                    <li><partial name="_EventCardCompact" model="EventCardViewModel.FromEvent(ev, showDate: false)" /></li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>

            <!-- TAB 2: By category - vertical lists, no sideways rows -->
            <div class="tab-pane fade" id="tab-cat" role="tabpanel" aria-labelledby="tab-cat-btn">
                @if (!Model.ByCategory.Any())
                {
                    <p class="gs-weekly-empty">@Localizer["Home_NoEventsForDay"]</p>
                }
                else
                {
                    @foreach (var cat in Model.ByCategory)
                    {
                        <div class="gs-weekly-category">
                            <div class="gs-weekly-category-head">
                                <h3 class="gs-weekly-category-title">
                                    @cat.DisplayName <span class="gs-tag">@cat.Events.Count</span>
                                </h3>
                                <a asp-controller="Events" asp-action="Index"
                                   asp-route-category="@cat.CategoryKey"
                                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
                                   class="gs-section-link">@Localizer["Home_ViewAllCategory"]</a>
                            </div>
                            <ul class="gs-weekly-list">
                                @foreach (var ev in cat.Events.Take(maxCategoryCards))
                                {
                                    <li><partial name="_EventCardCompact" model="EventCardViewModel.FromEvent(ev)" /></li>
                                }
                            </ul>
                            @if (cat.Events.Count > maxCategoryCards)
                            {
                                <a asp-controller="Events" asp-action="Index"
                                   asp-route-category="@cat.CategoryKey"
                                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
                                   class="gs-btn gs-btn-secondary gs-weekly-more">
                                    +@(cat.Events.Count - maxCategoryCards) @Localizer["Events_More"]
                                </a>
                            }
                        </div>
                    }
                }
            </div>

            <!-- TAB 3: Weekend - standard cards -->
            <div class="tab-pane fade" id="tab-weekend" role="tabpanel" aria-labelledby="tab-weekend-btn">
                @if (!Model.WeekendEvents.Any())
                {
                    <p class="gs-weekly-empty">@Localizer["Home_NoWeekendEvents"]</p>
                }
                else
                {
                    <ul class="gs-weekly-cards">
                        @foreach (var ev in Model.WeekendEvents)
                        {
                            <li><partial name="_EventCard" model="EventCardViewModel.FromEvent(ev)" /></li>
                        }
                    </ul>
                }
            </div>

            <!-- TAB 4: Calendar - number of events per day; a day opens its list -->
            <div class="tab-pane fade" id="tab-cal" role="tabpanel" aria-labelledby="tab-cal-btn">
                @{
                    var showTwoMonths = Model.FromDate.Year != Model.ToDate.Year
                                     || Model.FromDate.Month != Model.ToDate.Month;
                    var monthsToRender = new List<DateTime>
                    {
                        new DateTime(Model.FromDate.Year, Model.FromDate.Month, 1)
                    };
                    if (showTwoMonths)
                        monthsToRender.Add(new DateTime(Model.ToDate.Year, Model.ToDate.Month, 1));
                }
                @foreach (var monthStart in monthsToRender)
                {
                    var mLastDay = new DateTime(monthStart.Year, monthStart.Month,
                        DateTime.DaysInMonth(monthStart.Year, monthStart.Month));
                    int mStartOffset = ((int)monthStart.DayOfWeek + 6) % 7;
                    var mCalStart = monthStart.AddDays(-mStartOffset);
                    int mTotalCells = (int)Math.Ceiling((mStartOffset + mLastDay.Day) / 7.0) * 7;

                    <div class="gs-weekly-month">
                        <h3 class="gs-weekly-category-title text-capitalize">@monthStart.ToString("MMMM yyyy", displayCulture)</h3>
                        <table class="gs-calendar">
                            <thead>
                                <tr>
                                    @foreach (var dn in calDayNames)
                                    {
                                        <th scope="col">@dn</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int cell = 0; cell < mTotalCells; cell += 7)
                                {
                                    <tr>
                                        @for (int col = 0; col < 7; col++)
                                        {
                                            var cellDate = mCalStart.AddDays(cell + col);
                                            var isCurrentMonth = cellDate.Month == monthStart.Month;
                                            var isTodayCell = cellDate.Date == Model.Today.Date;
                                            var isInPeriod = isCurrentMonth
                                                && cellDate.Date >= Model.FromDate.Date
                                                && cellDate.Date <= Model.ToDate.Date;
                                            var count = Model.CalendarCounts.GetValueOrDefault(cellDate.Date, 0);
                                            var cellClass = isTodayCell ? "is-today"
                                                : isInPeriod ? "is-in-period"
                                                : !isCurrentMonth ? "is-other-month"
                                                : "";
                                            <td class="@cellClass">
                                                @if (isCurrentMonth && count > 0)
                                                {
                                                    <a asp-controller="Events" asp-action="Index"
                                                       asp-route-fromDate="@cellDate.ToString("yyyy-MM-dd")"
                                                       asp-route-toDate="@cellDate.ToString("yyyy-MM-dd")">
                                                        <span>@cellDate.Day</span>
                                                        <span class="gs-tag">@count</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span>@(isCurrentMonth ? cellDate.Day.ToString() : "")</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const ACTIVE_TAB_KEY = 'weeklyActiveTab';

    // Period arrows: reload the block for the previous / next 6 days, keeping the selected tab.
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.week-nav-btn');
        if (!btn) return;

        const fromDate = btn.dataset.from;
        const section = document.getElementById('weekly-events-section');
        if (!section || !fromDate) return;

        const activeTab = document.querySelector('#weeklyTabs [role="tab"][aria-selected="true"]');
        if (activeTab) sessionStorage.setItem(ACTIVE_TAB_KEY, activeTab.dataset.bsTarget);

        section.setAttribute('aria-busy', 'true');
        section.style.opacity = '0.5';
        section.style.pointerEvents = 'none';

        fetch(`/Home/WeeklyEventsPartial?fromDate=${fromDate}`)
            .then(r => r.text())
            .then(html => {
                section.outerHTML = html;

                const savedTab = sessionStorage.getItem(ACTIVE_TAB_KEY);
                if (savedTab) {
                    const tabBtn = document.querySelector(`#weeklyTabs [data-bs-target="${savedTab}"]`);
                    if (tabBtn) new bootstrap.Tab(tabBtn).show();
                }
            })
            .catch(() => {
                section.removeAttribute('aria-busy');
                section.style.opacity = '1';
                section.style.pointerEvents = '';
            });
    });

    // Day chips: show the chosen day's events (real buttons, so they work with the keyboard too).
    document.addEventListener('click', function (e) {
        const chip = e.target.closest('.gs-day-chip');
        if (!chip) return;

        const wrapper = chip.closest('#tab-day');
        if (!wrapper) return;

        const idx = chip.dataset.dayIndex;
        wrapper.querySelectorAll('.gs-day-chip').forEach(c => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
        wrapper.querySelectorAll('.gs-day-panel').forEach(p => { p.hidden = p.dataset.dayIndex !== idx; });
    });
});
</script>
