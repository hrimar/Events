@model Events.Web.Models.EventsSectionViewModel
@using Events.Web.Resources
@using Events.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@if(Model.Events.Any())
{
    <section class="py-3 bg-surface theme-section border-top">
        <div class="container-grid">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="home-section-title">@Model.Title</h2>
                @if(!string.IsNullOrEmpty(Model.ViewAllUrl))
                {
                    <a href="@Model.ViewAllUrl" class="btn btn-outline-primary">
                        @Model.ViewAllText <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                }
            </div>

            <div class="row">
                @foreach(var eventItem in Model.Events.Take(Model.MaxItems))
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <partial name="_EventCard" model="EventCardViewModel.FromEvent(eventItem)" />
                    </div>
                }
            </div>
        </div>
    </section>
}
