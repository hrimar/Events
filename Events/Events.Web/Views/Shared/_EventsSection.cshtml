@model Events.Web.Models.EventsSectionViewModel
@using Events.Web.Resources
@using Events.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@if(Model.Events.Any())
{
    @* Section header of the new visual system (GS-REQ-006, 6.5), as in the other homepage sections *@
    <section class="gs-home-section gs-events-section">
        <div class="container-grid">
            <div class="gs-section-head">
                <div class="gs-section-titles">
                    <h2 class="gs-h2 gs-section-title">@Model.Title</h2>
                </div>
                @if(!string.IsNullOrEmpty(Model.ViewAllUrl))
                {
                    <div class="gs-section-actions">
                        <a href="@Model.ViewAllUrl" class="gs-section-link">@Model.ViewAllText</a>
                    </div>
                }
            </div>

            <div class="row">
                @foreach(var eventItem in Model.Events.Take(Model.MaxItems))
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <partial name="_EventCard" model="EventCardViewModel.FromEvent(eventItem)" />
                    </div>
                }
            </div>
        </div>
    </section>
}
