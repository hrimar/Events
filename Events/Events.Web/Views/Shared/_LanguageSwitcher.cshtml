@using System.Globalization
@using Events.Web.Localization

@* Language switcher. The header shows only the other language ("EN" in BG, "БГ" in EN, GS-REQ-006 6.6);
   the footer shows both, with the current one marked. Pass ViewData["OtherLanguageOnly"] = true for the header.
   Plain links to the same page in the other language, with the same query string (GS-REQ-010, 10.2.4). *@
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower();
    var otherLanguageOnly = ViewData["OtherLanguageOnly"] is true;

    var languages = new[]
    {
        (Culture: SiteCultures.Bulgarian, Label: "БГ", Name: "Български"),
        (Culture: SiteCultures.English, Label: "EN", Name: "English")
    };
}

<div class="language-switcher d-flex gap-1">
    @foreach (var language in languages)
    {
        var isCurrent = language.Culture == currentCulture;
        if (otherLanguageOnly && isCurrent)
        {
            continue;
        }

        <a href="@SiteCultures.BuildPathForCulture(Context.Request, language.Culture)"
           class="gs-lang-btn @(isCurrent ? "is-current" : "")"
           title="@language.Name" lang="@language.Culture" hreflang="@language.Culture"
           aria-current="@(isCurrent ? "true" : null)">
            @language.Label
        </a>
    }
</div>
