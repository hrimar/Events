@model Events.Web.Models.Admin.SiteContentIndexViewModel
@using Events.Models.Entities
@using Events.Models.Enums
@{
    ViewData["Title"] = "Site Content";
    var activeTab = Model.ActiveTab ?? Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab))
        activeTab = "hero";

    var quickFilterForm = Model.QuickFilterForm;
    var selectableCategories = Enum.GetValues<EventCategory>().Where(c => c != EventCategory.Undefined).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Site Content</h1>
        <p class="text-muted mb-0">Edit Hero text, homepage quick filters, About Us content and SEO meta for static pages.</p>
    </div>
</div>

<ul class="nav nav-tabs mb-4" id="siteContentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "hero" ? "active" : "")" id="hero-tab" data-bs-toggle="tab"
                data-bs-target="#hero-pane" type="button" role="tab">
            <i class="fas fa-house me-1"></i>Hero
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "quick-filters" ? "active" : "")" id="quick-filters-tab" data-bs-toggle="tab"
                data-bs-target="#quick-filters-pane" type="button" role="tab">
            <i class="fas fa-filter me-1"></i>Homepage quick filters
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "about-us" ? "active" : "")" id="about-us-tab" data-bs-toggle="tab"
                data-bs-target="#about-us-pane" type="button" role="tab">
            <i class="fas fa-info-circle me-1"></i>About Us
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "seo" ? "active" : "")" id="seo-tab" data-bs-toggle="tab"
                data-bs-target="#seo-pane" type="button" role="tab">
            <i class="fas fa-magnifying-glass me-1"></i>SEO
        </button>
    </li>
</ul>

<div class="tab-content" id="siteContentTabsContent">

    <!-- Hero tab -->
    <div class="tab-pane fade @(activeTab == "hero" ? "show active" : "")" id="hero-pane" role="tabpanel">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="SaveHero" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Hero.HeroTitleBg" class="form-label"></label>
                            <input asp-for="Hero.HeroTitleBg" class="form-control" />
                            <span asp-validation-for="Hero.HeroTitleBg" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Hero.HeroTitleEn" class="form-label"></label>
                            <input asp-for="Hero.HeroTitleEn" class="form-control" />
                            <span asp-validation-for="Hero.HeroTitleEn" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Hero.HeroSubtitleBg" class="form-label"></label>
                            <textarea asp-for="Hero.HeroSubtitleBg" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Hero.HeroSubtitleBg" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Hero.HeroSubtitleEn" class="form-label"></label>
                            <textarea asp-for="Hero.HeroSubtitleEn" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Hero.HeroSubtitleEn" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save Hero
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Homepage quick filters tab -->
    <div class="tab-pane fade @(activeTab == "quick-filters" ? "show active" : "")" id="quick-filters-pane" role="tabpanel">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <p class="text-muted">
                    Chips in the "What" row of the homepage hero, in this order. Each opens "All events" for the next 7 days
                    with its filter. At most @HomeQuickFilter.MaxActive can be active
                    (now: <strong>@Model.ActiveQuickFilterCount</strong>).
                </p>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:110px;">Order</th>
                                <th>Label (BG)</th>
                                <th>Label (EN)</th>
                                <th>Type</th>
                                <th>Values</th>
                                <th style="width:90px;">Status</th>
                                <th style="width:250px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.QuickFilters.Any())
                            {
                                <tr><td colspan="7" class="text-muted text-center">No quick filters yet.</td></tr>
                            }
                            @for (var i = 0; i < Model.QuickFilters.Count; i++)
                            {
                                var filter = Model.QuickFilters[i];
                                <tr class="@(filter.IsActive ? "" : "text-muted")">
                                    <td>
                                        <div class="d-flex gap-1">
                                            <form asp-action="MoveQuickFilter" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@filter.Id" />
                                                <input type="hidden" name="offset" value="-1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(i == 0)"
                                                        title="Move up" aria-label="Move @filter.LabelEn up">
                                                    <i class="fas fa-arrow-up"></i>
                                                </button>
                                            </form>
                                            <form asp-action="MoveQuickFilter" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@filter.Id" />
                                                <input type="hidden" name="offset" value="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(i == Model.QuickFilters.Count - 1)"
                                                        title="Move down" aria-label="Move @filter.LabelEn down">
                                                    <i class="fas fa-arrow-down"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="fw-medium">@filter.LabelBg</td>
                                    <td>@filter.LabelEn</td>
                                    <td>@filter.Type</td>
                                    <td>@(filter.Values.Any() ? string.Join(", ", filter.Values) : "-")</td>
                                    <td>
                                        <span class="badge @(filter.IsActive ? "bg-success" : "bg-secondary")">@(filter.IsActive ? "Active" : "Inactive")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-action="Index" asp-route-tab="quick-filters" asp-route-editQuickFilterId="@filter.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-pen me-1"></i>Edit
                                            </a>
                                            <form asp-action="SetQuickFilterActive" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@filter.Id" />
                                                <input type="hidden" name="isActive" value="@(filter.IsActive ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    @(filter.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                            @* The label goes through a data attribute, never into the JavaScript source. *@
                                            <form asp-action="DeleteQuickFilter" method="post"
                                                  data-confirm="Delete the quick filter &quot;@filter.LabelEn&quot;?"
                                                  onsubmit="return confirm(this.dataset.confirm);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@filter.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete @filter.LabelEn">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">@(quickFilterForm.Id.HasValue ? "Edit quick filter" : "Add quick filter")</h2>
                <form asp-action="SaveQuickFilter" method="post" novalidate id="quickFilterForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@quickFilterForm.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="QuickFilter_LabelBg" class="form-label">Label (BG)</label>
                            <input id="QuickFilter_LabelBg" name="LabelBg" value="@quickFilterForm.LabelBg" class="form-control" maxlength="50" required />
                        </div>
                        <div class="col-md-4">
                            <label for="QuickFilter_LabelEn" class="form-label">Label (EN)</label>
                            <input id="QuickFilter_LabelEn" name="LabelEn" value="@quickFilterForm.LabelEn" class="form-control" maxlength="50" required />
                        </div>
                        <div class="col-md-4">
                            <label for="QuickFilter_Type" class="form-label">Type</label>
                            <select id="QuickFilter_Type" name="Type" class="form-select">
                                @foreach (var type in Enum.GetValues<HomeQuickFilterType>())
                                {
                                    <option value="@type" selected="@(quickFilterForm.Type == type)">@type</option>
                                }
                            </select>
                        </div>

                        <div class="col-12" data-quick-filter-values="Categories">
                            <span class="form-label d-block">Categories (an event in any of them matches)</span>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var category in selectableCategories)
                                {
                                    var categoryName = category.ToString();
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Categories" value="@categoryName"
                                               id="QuickFilter_Category_@categoryName"
                                               checked="@quickFilterForm.Categories.Contains(categoryName, StringComparer.OrdinalIgnoreCase)" />
                                        <label class="form-check-label" for="QuickFilter_Category_@categoryName">@categoryName</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-8" data-quick-filter-values="Tags">
                            <label for="QuickFilter_Tags" class="form-label">Tags (comma-separated, an event with any of them matches)</label>
                            <input id="QuickFilter_Tags" name="Tags" value="@quickFilterForm.Tags" class="form-control" maxlength="400"
                                   placeholder="For kids, Family-friendly" />
                            <div class="form-text">Use the English tag names exactly as on the Tags screen.</div>
                        </div>

                        <div class="col-12" data-quick-filter-values="Free">
                            <p class="text-muted mb-0">Shows free events only; no values needed.</p>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="QuickFilter_IsActive" name="IsActive" value="true"
                                       checked="@quickFilterForm.IsActive" />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="QuickFilter_IsActive">Active (shown on the homepage)</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        @if (quickFilterForm.Id.HasValue)
                        {
                            <a asp-action="Index" asp-route-tab="quick-filters" class="btn btn-outline-secondary">Cancel</a>
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>@(quickFilterForm.Id.HasValue ? "Save quick filter" : "Add quick filter")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- About Us tab -->
    <div class="tab-pane fade @(activeTab == "about-us" ? "show active" : "")" id="about-us-pane" role="tabpanel">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="SaveAboutUs" method="post" novalidate id="aboutUsForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">About Us Content (BG)</label>
                            <div id="quill-bg" class="bg-white" style="height: 240px;"></div>
                            <textarea asp-for="AboutUs.AboutUsContentBg" id="AboutUsContentBg" style="display:none"></textarea>
                            <span asp-validation-for="AboutUs.AboutUsContentBg" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">About Us Content (EN)</label>
                            <div id="quill-en" class="bg-white" style="height: 240px;"></div>
                            <textarea asp-for="AboutUs.AboutUsContentEn" id="AboutUsContentEn" style="display:none"></textarea>
                            <span asp-validation-for="AboutUs.AboutUsContentEn" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save About Us
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SEO tab -->
    <div class="tab-pane fade @(activeTab == "seo" ? "show active" : "")" id="seo-pane" role="tabpanel">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="SaveSeo" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th style="min-width:140px;">Page</th>
                                    <th style="min-width:220px;">Title (BG)</th>
                                    <th style="min-width:220px;">Title (EN)</th>
                                    <th style="min-width:260px;">Description (BG)</th>
                                    <th style="min-width:260px;">Description (EN)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.SeoItems.Count; i++)
                                {
                                    <tr>
                                        <td class="fw-medium">
                                            @Model.SeoItems[i].DisplayName
                                            <input type="hidden" asp-for="SeoItems[i].PageKey" />
                                        </td>
                                        <td><input asp-for="SeoItems[i].TitleBg" class="form-control form-control-sm" /></td>
                                        <td><input asp-for="SeoItems[i].TitleEn" class="form-control form-control-sm" /></td>
                                        <td><textarea asp-for="SeoItems[i].DescriptionBg" class="form-control form-control-sm" rows="2"></textarea></td>
                                        <td><textarea asp-for="SeoItems[i].DescriptionEn" class="form-control form-control-sm" rows="2"></textarea></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save SEO Meta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.snow.min.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.min.js"></script>
    <script>
        (function () {
            var toolbarOptions = [['bold'], ['link']];

            var quillBg = new Quill('#quill-bg', { theme: 'snow', modules: { toolbar: toolbarOptions } });
            var quillEn = new Quill('#quill-en', { theme: 'snow', modules: { toolbar: toolbarOptions } });

            var bgTextarea = document.getElementById('AboutUsContentBg');
            var enTextarea = document.getElementById('AboutUsContentEn');

            quillBg.root.innerHTML = bgTextarea.value;
            quillEn.root.innerHTML = enTextarea.value;

            document.getElementById('aboutUsForm').addEventListener('submit', function () {
                bgTextarea.value = quillBg.root.innerHTML;
                enTextarea.value = quillEn.root.innerHTML;
            });
        })();

        // Quick filter form: show only the value inputs of the selected type.
        (function () {
            var typeSelect = document.getElementById('QuickFilter_Type');
            if (!typeSelect) return;

            function showValuesForType() {
                document.querySelectorAll('[data-quick-filter-values]').forEach(function (block) {
                    block.hidden = block.getAttribute('data-quick-filter-values') !== typeSelect.value;
                });
            }

            typeSelect.addEventListener('change', showValuesForType);
            showValuesForType();
        })();
    </script>
}
