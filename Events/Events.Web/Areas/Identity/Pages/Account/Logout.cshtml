@page
@model LogoutModel
@{
    ViewData["Title"] = Localizer["Logout_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <gs-icon name="log-out" size="48" class="text-warning mb-3" />
                            <h2 class="fw-bold mb-3">@Localizer["Logout_ReadyToLeave"]</h2>
                            <p class="text-muted mb-4">@Localizer["Logout_Prompt"]</p>

                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                <button type="submit" class="gs-btn gs-btn-primary w-100">
                                    <gs-icon name="log-out" class="me-2" />@Localizer["Logout_Submit"]
                                </button>
                            </form>

                            <hr class="my-4">

                            <p class="mb-0">
                                <a asp-page="./Login" class="text-decoration-none">
                                    <gs-icon name="arrow-left" class="me-1" />@Localizer["Logout_GoBack"]
                                </a>
                            </p>
                        }
                        else
                        {
                            <gs-icon name="circle-check" size="48" class="text-success mb-3" />
                            <h2 class="fw-bold mb-3">@Localizer["Logout_SuccessTitle"]</h2>
                            <p class="text-muted mb-4">@Localizer["Logout_Success"]</p>

                            <hr class="my-4">

                            <div class="d-grid gap-2">
                                <a asp-page="/Account/Login" class="gs-btn gs-btn-primary text-decoration-none">
                                    <gs-icon name="log-in" class="me-2" />@Localizer["Logout_LoginAgain"]
                                </a>
                                <a href="/" class="btn btn-outline-secondary btn-lg text-decoration-none">
                                    <gs-icon name="house" class="me-2" />@Localizer["Logout_ReturnHome"]
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
