@page
@model LockoutModel
@{
    ViewData["Title"] = Localizer["Lockout_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center">
                        <gs-icon name="lock" size="48" class="text-danger mb-3" />
                        <h2 class="fw-bold">@ViewData["Title"]</h2>
                        <p class="text-muted mb-4">@Localizer["Lockout_Subtitle"]</p>

                        <div class="alert alert-warning" role="alert">
                            <gs-icon name="triangle-alert" class="me-2" />
                            @Localizer["Lockout_Alert"]
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <a asp-page="./Login" class="text-decoration-none">
                                <gs-icon name="arrow-left" class="me-1" />@Localizer["Account_BackToLogin"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
