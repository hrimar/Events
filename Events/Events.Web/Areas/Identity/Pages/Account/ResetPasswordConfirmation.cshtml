@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localizer["ResetPasswordConfirm_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <gs-icon name="circle-check" size="64" class="text-success mb-3" />
                        <h2 class="fw-bold">@Localizer["ResetPasswordConfirm_Heading"]</h2>
                    </div>
                    
                    <p class="lead mb-4">
                        @Localizer["ResetPasswordConfirm_Lead"]
                    </p>
                    
                    <p class="text-muted mb-4">
                        @Localizer["ResetPasswordConfirm_Hint"]
                    </p>
                    
                    <hr class="my-4">
                    
                    <div>
                        <a asp-page="./Login" class="gs-btn gs-btn-primary">
                            <gs-icon name="log-in" class="me-2" />@Localizer["ResetPasswordConfirm_LoginNow"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
