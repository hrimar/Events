@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = Localizer["ForgotPassword_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <gs-icon name="key-round" size="48" class="text-warning mb-3" />
                        <h2 class="fw-bold">@Localizer["ForgotPassword_Heading"]</h2>
                        <p class="text-muted">@Localizer["ForgotPassword_Subtitle"]</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label">
                                <gs-icon name="mail" class="me-2" />@Localizer["Account_Email"]
                            </label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" aria-required="true" placeholder="@Localizer["Account_PlaceholderEmail"]" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <gs-icon name="send" class="me-2" />@Localizer["ForgotPassword_Submit"]
                            </button>
                        </div>
                        
                        <hr class="my-4">
                        
                        <div class="text-center">
                            <p class="mb-0">
                                <a asp-page="./Login" class="text-decoration-none">
                                    <gs-icon name="arrow-left" class="me-1" />@Localizer["Account_BackToLogin"]
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
