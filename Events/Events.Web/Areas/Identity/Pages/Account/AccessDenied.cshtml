@page
@model AccessDeniedModel
@{
    ViewData["Title"] = Localizer["AccessDenied_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center">
                        <gs-icon name="ban" size="48" class="text-danger mb-3" />
                        <h2 class="fw-bold">@ViewData["Title"]</h2>
                        <p class="text-muted mb-4">@Localizer["AccessDenied_Subtitle"]</p>

                        <div class="alert alert-danger" role="alert">
                            <gs-icon name="circle-alert" class="me-2" />
                            @Localizer["AccessDenied_Alert"]
                        </div>

                        <hr class="my-4">

                        <div class="d-grid gap-2">
                            <a href="/" class="btn btn-primary btn-lg text-decoration-none">
                                <gs-icon name="house" class="me-2" />@Localizer["Account_BackToHome"]
                            </a>
                            <a asp-page="./Login" class="btn btn-outline-secondary btn-lg text-decoration-none">
                                <gs-icon name="log-in" class="me-2" />@Localizer["AccessDenied_Login"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
