@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = Localizer["LoginRecovery_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <gs-icon name="key-round" size="48" class="text-warning mb-3" />
                        <h2 class="fw-bold">@ViewData["Title"]</h2>
                        <p class="text-muted">@Localizer["LoginRecovery_Subtitle"]</p>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <gs-icon name="info" class="me-2" />
                        @Localizer["LoginRecovery_Alert"]
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Input.RecoveryCode" class="form-label">
                                <gs-icon name="lock" class="me-2" />@Localizer["LoginRecovery_Code"]
                            </label>
                            <input asp-for="Input.RecoveryCode" class="form-control form-control-lg" autocomplete="off" placeholder="@Localizer["LoginRecovery_Placeholder"]" />
                            <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                            <small class="text-muted d-block mt-2">
                                @Localizer["LoginRecovery_Hint"]
                            </small>
                        </div>
                        
                        <div class="d-grid mb-3">
                            <button type="submit" class="gs-btn gs-btn-primary">
                                <gs-icon name="log-in" class="me-2" />@Localizer["Login_Submit"]
                            </button>
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <a asp-page="./Login" class="text-decoration-none">
                                <gs-icon name="arrow-left" class="me-1" />@Localizer["Account_BackToLogin"]
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
