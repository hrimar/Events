@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = Localizer["ConfirmEmailChange_Title"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center">
                        <gs-icon name="mail-check" size="48" class="text-success mb-3" />
                        <h2 class="fw-bold">@ViewData["Title"]</h2>
                        <p class="text-muted mb-4">@Localizer["ConfirmEmailChange_Subtitle"]</p>

                        <div class="mt-4">
                            <partial name="_StatusMessage" model="Model.StatusMessage" />
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <a asp-page="./Login" class="text-decoration-none">
                                <gs-icon name="log-in" class="me-1" />@Localizer["Account_BackToLogin"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
