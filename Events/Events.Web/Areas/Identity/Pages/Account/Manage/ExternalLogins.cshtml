@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = Localizer["Manage_ExternalLogins_Title"];
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-3 col-md-4 mb-4 mb-md-0">
            <partial name="_ManageNav" />
        </div>

        <div class="col-lg-9 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <gs-icon name="link" size="48" class="text-primary mb-3" />
                        <h2 class="fw-bold">@ViewData["Title"]</h2>
                        <p class="text-muted">@Localizer["Manage_ExternalLogins_Subtitle"]</p>
                    </div>

                    <partial name="_StatusMessage" for="StatusMessage" />

                    @if (Model.CurrentLogins?.Count > 0)
                    {
                        <div class="mb-4">
                            <h5 class="mb-3">
                                <gs-icon name="circle-check" class="text-success me-2" />@Localizer["Manage_ExternalLogins_Connected"]
                            </h5>
                            <div class="list-group">
                                @foreach (var login in Model.CurrentLogins)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            <gs-icon name="log-in" class="me-2" />
                                            @login.ProviderDisplayName
                                        </span>
                                        @if (Model.ShowRemoveButton)
                                        {
                                            <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post" class="d-inline">
                                                <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                                <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="@login.ProviderDisplayName">
                                                    <gs-icon name="trash-2" class="me-1" />@Localizer["Manage_ExternalLogins_Remove"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.OtherLogins?.Count > 0)
                    {
                        <div>
                            <hr class="my-4">

                            <h5 class="mb-3">
                                <gs-icon name="circle-plus" class="text-info me-2" />@Localizer["Manage_ExternalLogins_AddService"]
                            </h5>
                            <p class="text-muted small mb-3">@Localizer["Manage_ExternalLogins_AddHint"]</p>
                            
                            <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
                                <div class="d-grid gap-2">
                                    @foreach (var provider in Model.OtherLogins)
                                    {
                                        <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="@provider.DisplayName">
                                            <gs-icon name="log-in" class="me-2" />@provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
